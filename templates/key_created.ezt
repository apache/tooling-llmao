[include "header.ezt"]
<div class="container py-4" style="max-width: 40rem;">
  <h1 class="h3 mb-3">API key created</h1>
  <div class="alert alert-warning">
    Copy this secret now. It will <strong>not</strong> be shown again.
  </div>
  <dl class="row small">
    <dt class="col-sm-3">Type</dt><dd class="col-sm-9">[kind_label]</dd>
    <dt class="col-sm-3">Project</dt><dd class="col-sm-9">[project]</dd>
    <dt class="col-sm-3">Purpose</dt><dd class="col-sm-9 font-monospace">[purpose]</dd>
    [if-any is_automation]
    <dt class="col-sm-3">Created by</dt>
    <dd class="col-sm-9 font-monospace">[created_by]</dd>
    [end]
  </dl>
  [if-any is_automation]
  <p class="small text-muted">
    You are recorded as <strong>created_by</strong>. Teammates cannot recover this
    secret from llmao — they will contact you for it.
  </p>
  [end]
  <label class="form-label" for="secret">Secret</label>
  <input class="form-control font-monospace" id="secret" type="text" readonly
         value="[secret]" onclick="this.select()">
  <div class="mt-3 d-flex gap-2">
    <a class="btn btn-primary" href="[keys_back]">Back to keys</a>
    <a class="btn btn-outline-secondary" href="[keys_create_another]">Create another</a>
  </div>
</div>
[include "footer.ezt"]
