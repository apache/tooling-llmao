[include "header.ezt"]
<div class="container py-4">
  <div class="mt-2">[include "flashes.ezt"]</div>

  <h1 class="h3 mb-3">My usage</h1>

  <p class="text-muted small">
    Free-tier work runs on ASF-hosted models and shares the fleet with every
    other committer. Heavy or sustained work belongs on a project allocation.
  </p>

  <div class="card mb-4">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-baseline mb-1">
        <span class="fw-semibold">Free tier</span>
        <span class="text-muted small">
          [used_h] of [cap_h] tokens &middot; rolling [window_days] days
        </span>
      </div>
      <div class="progress" style="height:10px" role="progressbar"
           aria-valuenow="[pct]" aria-valuemin="0" aria-valuemax="100"
           aria-label="Free tier usage">
        <div class="progress-bar[if-any exhausted] bg-danger[else][if-any nearly] bg-warning[end][end]"
             style="width:[pct]%"></div>
      </div>

      [if-any exhausted]
      <p class="small mt-2 mb-0">
        <span class="fw-semibold">You are out for now.</span>
        [if-any next_return]
        [next_return_amount_h] tokens return [next_return].
        [end]
      </p>
      [else]
      <p class="text-muted small mt-2 mb-0">
        [remaining_h] left.
        [if-any next_return]
        [next_return_amount_h] more returns [next_return].
        [end]
      </p>
      [end]
    </div>
  </div>

  [if-any projects]
  <h2 class="h5 mb-2">Projects</h2>
  <div class="table-responsive">
    <table class="table table-sm align-middle">
      <thead>
        <tr>
          <th>Project</th>
          <th class="text-end">Tokens</th>
          <th class="text-end">Commercial spend</th>
        </tr>
      </thead>
      <tbody>
        [for projects]
        <tr>
          <td><a href="/projects/[projects.name]">[projects.name]</a></td>
          <td class="text-end">[projects.tokens_h]</td>
          <td class="text-end">[projects.spend_h]</td>
        </tr>
        [end]
      </tbody>
    </table>
  </div>
  <p class="text-muted small">
    Commercial spend is real money against the project&rsquo;s budget. Tokens
    on ASF-hosted models are a share of fleet capacity, not a bill &mdash; the
    hardware costs the same whether or not it is busy.
  </p>
  [else]
  <p class="text-muted small">
    You are not on a project allocation. Project keys draw on a PMC&rsquo;s
    share and can reach commercial models; ask your PMC if you need one.
  </p>
  [end]

</div>
[include "footer.ezt"]
