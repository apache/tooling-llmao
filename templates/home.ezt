[include "header.ezt"]
<div class="container py-4 home-page">
    <div class="mt-2">
        [include "flashes.ezt"]
    </div>

    <h1 class="h3 mb-3">Welcome to Apache LLMAO</h1>
    <p class="llmao-lede text-muted">
        The ASF's gateway to AI models. Use Foundation-sanctioned models from
        any OpenAI&nbsp;API-compatible tool, with your usage attributed to you.
        Three steps get you there.
    </p>

    <ol class="home-steps list-unstyled mt-4">
        <li class="home-step[if-any uid] home-step-done[end]">
            <h2 class="h6 mb-1">Sign in</h2>
            [if-any uid]
            <p class="text-muted mb-0">
                Signed in as <span class="font-monospace">[uid]</span>[if-any projects_label]
                &middot; projects: [projects_label][end]
            </p>
            [else]
            <p class="text-muted mb-2">Use your ASF account.</p>
            <a class="btn btn-primary btn-sm" href="/auth?login=/">Sign in with ASF</a>
            [end]
        </li>
        <li class="home-step[if-any key_step_done] home-step-done[end]">
            <h2 class="h6 mb-1">Create a key</h2>
            [if-any key_step_done]
            <p class="text-muted mb-2">
                You have a key. Your keys and what each has drawn are on My Keys.
            </p>
            <a class="btn btn-outline-primary btn-sm" href="/keys">My Keys</a>
            [else]
            <p class="text-muted mb-2">
                A personal access token ties your usage to you and one of your
                projects. The secret is shown once.
            </p>
            [if-any uid]<a class="btn btn-primary btn-sm" href="/keys/new">Create a key</a>[end]
            [end]
        </li>
        <li class="home-step[if-any tool_step_done] home-step-done[end]">
            <h2 class="h6 mb-1">Connect a tool</h2>
            [if-any tool_step_done]
            <p class="text-muted mb-2">
                Your requests are flowing. Every model's ID, context window, and
                who can see your prompts is on the Models page.
            </p>
            [else]
            <p class="text-muted mb-2">
                Point it at <span class="font-monospace">https://llm.apache.org</span>
                and use that token as the key. The endpoint follows the OpenAI API.
                Pick a model ID from the Models page, which lists each model's
                context window and who can see your prompts.
            </p>
            [end]
            <a class="btn btn-outline-primary btn-sm" href="/help">Help</a>
            <a class="btn btn-outline-primary btn-sm" href="/models">Models</a>
        </li>
    </ol>
</div>
[include "footer.ezt"]
