[include "header.ezt"]
<div class="container py-4">
    <div class="mt-2">
        [include "flashes.ezt"]
    </div>

    <h1 class="h3 mb-3">Apache LLMAO</h1>
    <p class="llmao-lede text-muted">
        The ASF's gateway to AI models. Sign in with your ASF account,
        create a personal access token (PAT), and use Foundation-sanctioned
        models from any OpenAI&nbsp;API-compatible tool, with your
        usage attributed to you.
    </p>
    <p class="text-muted">
        Point your tool at <span class="font-monospace">https://llm.apache.org</span>
        and use your PAT as the key. The endpoint follows the OpenAI API specification.
    </p>

    [if-any uid]
    <div class="card mb-3" style="max-width: 28rem;">
        <div class="card-body">
            <h2 class="h6 card-title">Signed in</h2>
            <p class="card-text mb-0">
                <span class="font-monospace">[uid]</span>
                [if-any projects_label]
                <br><span class="text-muted small">projects: [projects_label]</span>
                [end]
            </p>
            <a class="btn btn-primary btn-sm mt-3" href="/keys">Manage my keys</a>
        </div>
    </div>
    [else]
    <p>
        <a class="btn btn-primary" href="/auth?login=/">Sign in with ASF</a>
    </p>
    [end]
</div>
[include "footer.ezt"]
