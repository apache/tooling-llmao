[include "header.ezt"]
<div class="container py-4">
  <div class="mt-2">[include "flashes.ezt"]</div>

  <p class="small mb-2">
    <a href="/projects">← Projects</a>
  </p>
  <h1 class="h3 mb-3">[project]</h1>

  [if-any error]
  <div class="alert alert-warning">[error]</div>
  [else]
  <p class="text-muted">
    Project overview (budget meters, by-person usage) is next.
  </p>
  [end]
</div>
[include "footer.ezt"]
