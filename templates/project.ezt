[include "header.ezt"]
<div class="container py-4">
  <div class="mt-2">[include "flashes.ezt"]</div>

  <p class="small mb-2">
    <a href="/projects">&larr; Projects</a>
  </p>
  <h1 class="h3 mb-3">[project]</h1>

  [if-any is_pmc]
  <p class="text-muted small">
    You are a PMC member and can issue keys for this project. The total
    allocation is set by ASF infrastructure.
  </p>
  [end]

  <div class="card mb-4">
    <div class="card-body py-3">
      <div class="d-flex justify-content-between align-items-baseline mb-1">
        <span class="fw-semibold">Capacity</span>
        <span class="small text-muted">
          [tokens_h] tokens[if-any cap_h] of [cap_h][end] this week
          &middot; about [capacity_h]
        </span>
      </div>
      [if-any cap_h]
      <div class="progress mb-2" style="height:8px" role="progressbar"
           aria-valuenow="[tokens_pct]" aria-valuemin="0" aria-valuemax="100"
           aria-label="Project capacity used">
        <div class="progress-bar" style="width:[tokens_pct]%"></div>
      </div>
      [else]
      <p class="small text-muted mb-2">No weekly allocation set.</p>
      [end]

      [if-any is_pmc]
      [if-any pending_request]
      <p class="small text-muted mb-3">
        Requested [pending_request.wanted_h] &mdash; waiting on ASF
        infrastructure.
      </p>
      [else]
      <form method="post" action="/do-request-capacity" class="row g-2 mb-3">
        <input type="hidden" name="project" value="[project]">
        <input type="hidden" name="after_path" value="/projects/[project]">
        <div class="col-auto">
          <input class="form-control form-control-sm" type="text"
                 name="token_cap" placeholder="e.g. 40000000"
                 aria-label="Requested weekly tokens" style="width:11rem">
        </div>
        <div class="col">
          <input class="form-control form-control-sm" type="text"
                 name="reason" placeholder="What the extra capacity is for"
                 aria-label="Reason">
        </div>
        <div class="col-auto">
          <button class="btn btn-outline-primary btn-sm" type="submit">
            Request more
          </button>
        </div>
      </form>
      [end]
      [end]

      <div class="d-flex justify-content-between align-items-baseline mb-1">
        <span class="fw-semibold">Commercial budget</span>
        <span class="small text-muted">
          [spend_h][if-any budget_h] of [budget_h][end]
        </span>
      </div>
      [if-any budget_h]
      <div class="progress" style="height:8px" role="progressbar"
           aria-valuenow="[spend_pct]" aria-valuemin="0" aria-valuemax="100"
           aria-label="Commercial budget used">
        <div class="progress-bar bg-warning" style="width:[spend_pct]%"></div>
      </div>
      [else]
      <p class="small text-muted mb-0">No commercial budget set.</p>
      [end]
    </div>
  </div>

  [if-any members]
  <h2 class="h5 mb-2">Who is drawing</h2>
  <div class="table-responsive">
    <table class="table table-sm align-middle">
      <thead>
        <tr>
          <th>Member</th>
          <th class="text-end">Tokens</th>
          <th class="text-end">Commercial</th>
          <th class="text-end">Keys</th>
        </tr>
      </thead>
      <tbody>
        [for members]
        <tr>
          <td>
            [members.name]
            [if-any members.is_service]
            <span class="badge text-bg-secondary ms-1">service</span>
            [end]
          </td>
          <td class="text-end font-monospace small">[members.tokens_h]</td>
          <td class="text-end font-monospace small">[members.spend_h]</td>
          <td class="text-end small text-muted">[members.keys]</td>
        </tr>
        [end]
      </tbody>
    </table>
  </div>
  <p class="text-muted small">
    Service keys appear as their own row rather than under whoever created
    them, so these figures sum to the project total. Commercial spend is real
    money; tokens on ASF-hosted models are a share of fleet capacity.
  </p>
  [else]
  <p class="text-muted">No usage recorded this week.</p>
  [end]

</div>
[include "footer.ezt"]
