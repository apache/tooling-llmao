[include "header.ezt"]
<div class="container py-4">
  <div class="mt-2">[include "flashes.ezt"]</div>

  <h1 class="h3 mb-3">Models</h1>
  <p class="text-muted small">
    Models you can call with a personal key. Use the <strong>ID</strong> as
    the <code>model</code> parameter. License and hosting are in Details.
  </p>

  [if-any attention]
  <div class="alert alert-warning py-2 small">
    <strong>Needs attention</strong>
    <ul class="mb-0 mt-1 ps-3">
      [for attention]
      <li>
        [attention.what]
        [if-any attention.detail]
        <span class="text-muted">— [attention.detail]</span>
        [end]
        [if-any attention.host]
        <form method="post" action="/do-set-admin-label" class="d-inline ms-2">
          <input type="hidden" name="host" value="[attention.host]">
          <select name="label" class="form-select form-select-sm d-inline-block"
                  style="width: auto; display: inline-block;"
                  aria-label="Label for [attention.host]">
            [for attention.label_options]
            <option value="[attention.label_options.value]"[is attention.label_options.value attention.label_value] selected[end]>[attention.label_options.text]</option>
            [end]
          </select>
          [if-any attention.label_at]
          <span class="text-muted small ms-1">([attention.label_at])</span>
          [end]
          <button type="submit" class="btn btn-sm btn-outline-secondary ms-1">Set</button>
        </form>
        [if-any attention.approve]
        <button type="button" class="btn btn-sm btn-outline-primary ms-1"
                data-bs-toggle="modal" data-bs-target="#approveBoxModal"
                data-host="[attention.host]" data-models="[attention.approved]">Approve</button>
        [end]
        [end]
      </li>
      [end]
    </ul>
  </div>
  [end]

  [if-any models]
  <div class="table-responsive">
    <table class="table table-sm table-hover align-middle">
      <thead>
        <tr>
          <th>Model</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        [for models]
        <tr[if-any models.unavailable] class="table-secondary text-muted"[end]>
          <td>
            <div>
              [models.display_name]
              <span class="font-monospace text-muted small ms-1">[models.model_name]</span>
            </div>
            <div class="small text-muted mt-1">
              [for models.chips]
              <span class="badge text-bg-secondary" title="[models.chips.title]">[models.chips.label]</span>
              [end]
              [if-any models.supports_thinking]
              <span class="badge text-bg-info" title="Reasons before answering">Thinking</span>
              [end]
              <span class="ms-1">[models.context_window] context</span>
              <span class="ms-1">[models.license]</span>
            </div>
            [if-any models.privacy]
            <div class="small mt-1">[models.privacy]</div>
            [end]
            [if-any models.concurrency]
            <div class="small text-muted">[models.concurrency]</div>
            [end]
          </td>
          <td>
            [if-any models.available]
            [if-any models.degraded]
            <span class="badge text-bg-warning">[models.rollup_label]</span>
            [else]
            <span class="badge text-bg-success">[models.rollup_label]</span>
            [end]
            [else]
            <span class="badge text-bg-secondary">[models.rollup_label]</span>
            [end]
          </td>
          <td class="text-end text-nowrap">
            [if-any models.available]
            <a class="btn btn-outline-primary btn-sm me-1"
               href="/keys/new?model=[models.model_name]">Request a key</a>
            [else]
            <span class="btn btn-outline-secondary btn-sm me-1 disabled"
                  title="Not available to you">Request a key</span>
            [end]
            <button type="button" class="btn btn-outline-secondary btn-sm"
                    data-bs-toggle="modal" data-bs-target="#modelDetailModal"
                    data-model-name="[models.model_name]"
                    data-display-name="[models.display_name]"
                    data-hosting="[models.hosting_label]"
                    data-context="[models.context_window]"
                    data-license="[models.license]"
                    data-modality="[models.modality]"
                    data-openness="[models.openness]"
                    data-thinking="[models.supports_thinking]"
                    data-thinks-default="[models.thinks_by_default]"
                    data-notes="[models.notes]"
                    data-reveal-supply="[models.reveal_supply]"
                    data-weights="[models.weights_distribution]"
                    data-training="[models.training_data_provenance]"
                    data-provenance="[models.provenance_record]">
              Details
            </button>
          </td>
        </tr>
        [end]
      </tbody>
    </table>
  </div>
  [else]
  <p class="text-muted">No models in the inventory.</p>
  [end]

  [if-any is_site_admin]
  <h2 class="h5 mt-4">Deployments</h2>
  <p class="text-muted small">
    Replicas per model. A label notes a host (for example: approved before it
    is in <code>fleet.hosts</code>).
  </p>
  [for models]
  <div class="accordion accordion-flush mb-3" id="model[models.index]">
    <div class="accordion-item">
      <h3 class="accordion-header" id="modelHeading[models.index]">
        <button class="accordion-button collapsed" type="button"
                data-bs-toggle="collapse" data-bs-target="#modelDeploy[models.index]"
                aria-expanded="false" aria-controls="modelDeploy[models.index]">
          <strong>[models.display_name]</strong>
          <span class="font-monospace text-muted small ms-1">[models.model_name]</span>
          <span class="badge text-bg-secondary ms-2">[models.rollup_label]</span>
          <span class="text-muted small ms-2">[models.replica_summary]</span>
        </button>
      </h3>
      <div id="modelDeploy[models.index]" class="accordion-collapse collapse"
           aria-labelledby="modelHeading[models.index]">
        <div class="accordion-body p-2">
        <div class="table-responsive">
          <table class="table table-sm table-hover align-middle mb-0">
            <thead>
              <tr>
                <th>Name</th>
                <th>Listen</th>
                <th>Public</th>
                <th>State</th>
                <th>Context</th>
                <th>KV cache</th>
                <th>Last ok</th>
                <th>LiteLLM health</th>
                <th>Config request</th>
                <th>Skew</th>
                <th>Label</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              [for models.deployments]
              <tr class="[models.deployments.row_class]">
                <td>
                  [models.deployments.name]
                  [if-any models.deployments.unknown][else]
                  [if-any models.deployments.self_hosted][else]
                  <span class="badge text-bg-secondary ms-1">external</span>
                  [end]
                  [end]
                </td>
                <td class="font-monospace small">[models.deployments.listen]</td>
                <td class="font-monospace small">[models.deployments.public]</td>
                <td>
                  [if-any models.deployments.unknown]
                  [models.deployments.state]
                  [else]
                  [if-any models.deployments.serving]
                  <span class="badge text-bg-success">[models.deployments.state]</span>
                  [end]
                  [if-any models.deployments.no_deployment]
                  <span class="badge text-bg-warning text-dark">[models.deployments.state]</span>
                  [end]
                  [if-any models.deployments.loading]
                  <span class="badge text-bg-secondary">[models.deployments.state]</span>
                  [end]
                  [if-any models.deployments.awaiting]
                  <span class="badge text-bg-info text-dark">[models.deployments.state]</span>
                  [end]
                  [if-any models.deployments.unhealthy]
                  <span class="badge text-bg-danger">[models.deployments.state]</span>
                  [end]
                  [if-any models.deployments.pending]
                  <span class="badge text-bg-light text-dark">[models.deployments.state]</span>
                  [end]
                  [end]
                  [if-any models.deployments.detail]
                  <div class="text-muted small">[models.deployments.detail]</div>
                  [end]
                </td>
                <td class="small font-monospace">[models.deployments.context]</td>
                <td class="small font-monospace">
                  [if-any models.deployments.oversized]
                  <span class="badge text-bg-danger" title="Context window exceeds the measured KV cache. vLLM will hang on a request that needs the space rather than refuse it.">[models.deployments.kv_cache]</span>
                  [else]
                  [models.deployments.kv_cache]
                  [end]
                </td>
                <td class="small">[models.deployments.last_ok]</td>
                <td class="small">[models.deployments.litellm_health]
                  <span class="text-muted">[models.deployments.litellm_health_ago]</span>
                </td>
                <td class="small">[models.deployments.config_ago]</td>
                <td class="small">[models.deployments.skew]</td>
                <td class="text-nowrap">
                  [if-any models.deployments.host]
                  <form method="post" action="/do-set-admin-label" class="d-inline">
                    <input type="hidden" name="host" value="[models.deployments.host]">
                    <select name="label" class="form-select form-select-sm"
                            aria-label="Label for [models.deployments.host]">
                      [for models.deployments.label_options]
                      <option value="[models.deployments.label_options.value]"[is models.deployments.label_options.value models.deployments.label_value] selected[end]>[models.deployments.label_options.text]</option>
                      [end]
                    </select>
                    <button type="submit" class="btn btn-sm btn-outline-secondary mt-1">Set</button>
                  </form>
                  [if-any models.deployments.label_at]
                  <div class="text-muted small">[models.deployments.label_at]</div>
                  [end]
                  [end]
                </td>
                <td class="text-nowrap">
                  [if-any models.deployments.show_add]
                  [if-any models.deployments.add_enabled]
                  <form method="post" action="/do-add-deployment" class="d-inline">
                    <input type="hidden" name="name" value="[models.deployments.name]">
                    <input type="hidden" name="host" value="[models.deployments.host]">
                    <button type="submit" class="btn btn-sm btn-primary">Add</button>
                  </form>
                  [else]
                  <button type="button" class="btn btn-sm btn-outline-secondary" disabled title="vLLM is not serving yet">Add</button>
                  [end]
                  [end]
                  [if-any models.deployments.show_remove]
                  [if-any models.deployments.remove_enabled]
                  <form method="post" action="/do-remove-deployment" class="d-inline">
                    <input type="hidden" name="name" value="[models.deployments.name]">
                    <input type="hidden" name="host" value="[models.deployments.host]">
                    <button type="submit" class="btn btn-sm btn-outline-danger ms-1">Remove</button>
                  </form>
                  [else]
                  <button type="button" class="btn btn-sm btn-outline-secondary ms-1" disabled title="Remove only when vLLM is unhealthy or stalled">Remove</button>
                  [end]
                  [end]
                </td>
              </tr>
              [end]
            </tbody>
          </table>
        </div>
        </div>
      </div>
    </div>
  </div>
  [end]
  [end]
</div>

<div class="modal fade" id="modelDetailModal" tabindex="-1"
     aria-labelledby="modelDetailModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="modelDetailModalLabel">Model details</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <dl class="row small mb-0" id="modelDetailBody">
          <dt class="col-sm-3">Name</dt>
          <dd class="col-sm-9" id="mdDisplayName"></dd>
          <dt class="col-sm-3">ID</dt>
          <dd class="col-sm-9 font-monospace" id="mdModelName"></dd>
          <dt class="col-sm-3">Hosting</dt>
          <dd class="col-sm-9" id="mdHosting"></dd>
          <dt class="col-sm-3">Context</dt>
          <dd class="col-sm-9 font-monospace" id="mdContext"></dd>
          <dt class="col-sm-3">License</dt>
          <dd class="col-sm-9" id="mdLicense"></dd>
          <dt class="col-sm-3">Modality</dt>
          <dd class="col-sm-9" id="mdModality"></dd>
          <dt class="col-sm-3">Openness</dt>
          <dd class="col-sm-9" id="mdOpenness"></dd>
          <dt class="col-sm-3">Thinking</dt>
          <dd class="col-sm-9" id="mdThinking"></dd>
          <dt class="col-sm-3">Notes</dt>
          <dd class="col-sm-9" id="mdNotes"></dd>
        </dl>
        <div id="mdSupplyBlock" class="mt-3 d-none">
          <h3 class="h6 text-muted">Supply path (site admins)</h3>
          <dl class="row small mb-0">
            <dt class="col-sm-3">Weights</dt>
            <dd class="col-sm-9" id="mdWeights"></dd>
            <dt class="col-sm-3">Training data</dt>
            <dd class="col-sm-9" id="mdTraining"></dd>
            <dt class="col-sm-3">Provenance record</dt>
            <dd class="col-sm-9" id="mdProvenance"></dd>
          </dl>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>
[if-any is_site_admin]
<div class="modal fade" id="approveBoxModal" tabindex="-1" aria-labelledby="approveBoxModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <form class="modal-content" method="post" action="/do-approve-box">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="approveBoxModalLabel">Approve box</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="small text-muted">Choose the models this box loads the next time it asks for its config.</p>
        <input type="hidden" name="host" id="approve-host" value="">
        [for approve_choices]
        <div class="form-check">
          <input class="form-check-input" type="checkbox" name="model" value="[approve_choices.model_name]" id="approve-[approve_choices.model_name]">
          <label class="form-check-label" for="approve-[approve_choices.model_name]">[approve_choices.display_name]</label>
        </div>
        [end]
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Approve</button>
      </div>
    </form>
  </div>
</div>
<script>
document.getElementById("approveBoxModal").addEventListener("show.bs.modal", function (ev) {
  var btn = ev.relatedTarget;
  var host = btn.getAttribute("data-host") || "";
  var picked = (btn.getAttribute("data-models") || "").split(",");
  document.getElementById("approve-host").value = host;
  document.getElementById("approveBoxModalLabel").textContent = "Approve " + host;
  document.querySelectorAll("#approveBoxModal input[name=model]").forEach(function (cb) {
    cb.checked = picked.indexOf(cb.value) !== -1;
  });
});
</script>
[end]
[include "footer.ezt"]
