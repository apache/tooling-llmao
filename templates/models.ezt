[include "header.ezt"]
<div class="container py-4 models-page">
  <div class="mt-2">[include "flashes.ezt"]</div>

  <h1 class="h3 mb-3">Models</h1>
  <p class="text-muted small">
    Models you can call with a personal key. Use the <strong>ID</strong> as
    the <code>model</code> parameter.
  </p>

  [if-any attention]
  <div class="alert alert-warning py-2 small">
    <strong>Needs attention</strong>
    <ul class="mb-0 mt-1 ps-3">
      [for attention]
      <li class="mb-2">
        [if-any attention.anchor]
        <a href="#[attention.anchor]" class="font-monospace js-dep-link">[attention.ident]</a>
        · [attention.rest]
        [else]
        [attention.what]
        [end]
        [if-any attention.detail]
        <span class="text-muted">— [attention.detail]</span>
        [end]
        [if-any attention.flag]
        <span class="text-muted ms-1">[attention.flag]</span>
        [end]
        <span class="ms-1">
          [for attention.actions]
          [if-any attention.actions.is_approve]
          <button type="button" class="btn btn-sm btn-outline-primary ms-1"
                  data-bs-toggle="modal" data-bs-target="#approveBoxModal"
                  aria-label="[attention.actions.aria]"
                  data-host="[attention.actions.host]" data-models="[attention.actions.approved]">Approve</button>
          [else]
          [if-any attention.actions.enabled]
          <form method="post" action="[attention.actions.post]" class="d-inline"[if-any attention.actions.confirm] data-confirm="[attention.actions.confirm]"[end]>
            <input type="hidden" name="host" value="[attention.actions.host]">
            [if-any attention.actions.is_label]
            <input type="hidden" name="label" value="[attention.actions.label_value]">
            [end]
            [if-any attention.actions.name]
            <input type="hidden" name="name" value="[attention.actions.name]">
            [end]
            [if-any attention.actions.port]
            <input type="hidden" name="port" value="[attention.actions.port]">
            [end]
            <button type="submit" class="btn btn-sm btn-outline-secondary ms-1"
                    aria-label="[attention.actions.aria]">[attention.actions.label]</button>
          </form>
          [else]
          <button type="button" class="btn btn-sm btn-outline-secondary ms-1"
                  aria-label="[attention.actions.aria]" disabled>[attention.actions.label]</button>
          <span class="text-muted small">[attention.actions.reason]</span>
          [end]
          [end]
          [end]
        </span>
      </li>
      [end]
    </ul>
  </div>
  [end]

  [if-any models]
  <div class="row row-cols-1 row-cols-md-2 g-3">
        [for models]
        <div class="col">
        <div class="card h-100 model-card[if-any models.unavailable] model-card-off[end]">
          <div class="card-body d-flex flex-column">
            <div class="d-flex align-items-baseline flex-wrap gap-2">
              <h2 class="h5 mb-0">[models.display_name]</h2>
              <code class="model-id">[models.model_name]</code>
              <button type="button" class="btn btn-link btn-sm p-0 js-copy-model"
                      aria-label="Copy the ID [models.model_name]"
                      data-copy="[models.model_name]">Copy</button>
            </div>
            [if-any models.privacy]
            <div class="model-privacy model-privacy-[models.privacy_key] mt-2">
              <i class="bi [models.privacy_icon]" aria-hidden="true"></i>
              <div><strong>[models.privacy_lead].</strong> [models.privacy_rest]</div>
            </div>
            [end]
            <div class="mt-2">
              [for models.chips]
              <span class="badge text-bg-secondary" title="[models.chips.title]">[models.chips.label]</span>
              [end]
              [if-any models.supports_thinking]
              <span class="badge text-bg-info" title="Reasons before answering">Thinking</span>
              [end]
            </div>
            <div class="small text-muted mt-2">
              [models.context_window] context · [models.license][if-any models.concurrency] · [models.concurrency][end]
            </div>
            <div class="mt-auto pt-3 d-flex align-items-center flex-wrap gap-2">
            [if-any models.available]
            [if-any models.degraded]
            <span class="badge text-bg-warning">[models.rollup_label]</span>
            [else]
            <span class="badge text-bg-success">[models.rollup_label]</span>
            [end]
            <a class="btn btn-outline-primary btn-sm"
               href="/keys/new?model=[models.model_name]">Request a key</a>
            [else]
            <span class="badge text-bg-secondary">[models.rollup_label]</span>
            <button type="button" class="btn btn-outline-secondary btn-sm" disabled>Request a key</button>
            <span class="small text-muted">Unavailable right now</span>
            [end]
            <button type="button" class="btn btn-link btn-sm p-0 ms-auto"
                    data-bs-toggle="modal" data-bs-target="#modelDetailModal"
                    data-model-name="[models.model_name]"
                    data-display-name="[models.display_name]"
                    data-hosting="[models.hosting_label]"
                    data-context="[models.context_window]"
                    data-license="[models.license]"
                    data-modality="[models.modality]"
                    data-openness="[models.openness]"
                    data-thinking="[models.supports_thinking]"
                    data-thinks-default="[models.thinks_by_default]"
                    data-notes="[models.notes]"
                    data-reveal-supply="[models.reveal_supply]"
                    data-weights="[models.weights_distribution]"
                    data-training="[models.training_data_provenance]"
                    data-provenance="[models.provenance_record]"
                    data-self-count="[models.self_count]"
                    data-external-count="[models.external_count]">
              Details
            </button>
            </div>
          </div>
        </div>
        </div>
        [end]
  </div>
  [else]
  <p class="text-muted">No models in the inventory.</p>
  [end]

  [if-any is_site_admin]
  <h2 class="h5 mt-4">Deployments</h2>
  <p class="text-muted small">
    One row per host:port. Admin flags reset when the control plane restarts.
  </p>
  <div class="list-group dep-list mb-3">
    [for models]
    <div class="list-group-item dep-model">
      <span class="fw-semibold">[models.display_name]</span>
      <span class="font-monospace text-muted small ms-1">[models.model_name]</span>
      <span class="badge text-bg-secondary ms-2">[models.rollup_label]</span>
      <span class="text-muted small ms-2">[models.replica_summary]</span>
    </div>
    [for models.deployments]
    <div class="list-group-item dep-row[if-any models.deployments.attention] dep-attention[end]" id="[models.deployments.anchor]">
      <div class="dep-grid">
        <div class="dep-state"><span class="badge [models.deployments.badge_class]">[models.deployments.state]</span></div>
        <div class="dep-ident font-monospace small">
          [models.deployments.ident]
          [if-any models.deployments.external]<span class="text-muted">external</span>[end]
        </div>
        <div class="dep-reason small">[models.deployments.detail]</div>
        <div class="dep-flag small text-muted">[models.deployments.flag]</div>
        <div class="dep-actions">
          [for models.deployments.primary]
          <form method="post" action="[models.deployments.primary.post]" class="d-inline">
            <input type="hidden" name="host" value="[models.deployments.primary.host]">
            <input type="hidden" name="name" value="[models.deployments.primary.name]">
            <input type="hidden" name="port" value="[models.deployments.primary.port]">
            <button type="submit" class="btn btn-sm btn-outline-primary"
                    aria-label="[models.deployments.primary.aria]">[models.deployments.primary.label]</button>
          </form>
          [end]
          [if-any models.deployments.menu]
          <div class="dropdown d-inline-block">
            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="dropdown"
                    aria-expanded="false" aria-label="More actions for [models.deployments.ident]">⋯</button>
            <ul class="dropdown-menu dropdown-menu-end">
              [for models.deployments.menu]
              <li>
                <form method="post" action="[models.deployments.menu.post]"[if-any models.deployments.menu.confirm] data-confirm="[models.deployments.menu.confirm]"[end]>
                  <input type="hidden" name="host" value="[models.deployments.menu.host]">
                  [if-any models.deployments.menu.is_label]
                  <input type="hidden" name="label" value="[models.deployments.menu.label_value]">
                  [end]
                  [if-any models.deployments.menu.name]
                  <input type="hidden" name="name" value="[models.deployments.menu.name]">
                  [end]
                  [if-any models.deployments.menu.port]
                  <input type="hidden" name="port" value="[models.deployments.menu.port]">
                  [end]
                  <button type="submit" class="dropdown-item"
                          aria-label="[models.deployments.menu.aria]">[models.deployments.menu.label]</button>
                </form>
              </li>
              [end]
            </ul>
          </div>
          [end]
        </div>
      </div>
      [if-any models.deployments.oversized]
      <div class="small text-danger mt-1">Context window exceeds the measured KV cache. vLLM will hang on a request that needs the space rather than refuse it.</div>
      [end]
      [if-any models.deployments.diags]
      <div class="dep-diag small text-muted mt-1">
        [for models.deployments.diags]
        <span>[models.deployments.diags.label] [models.deployments.diags.value]</span>
        [end]
      </div>
      [end]
      [if-any models.deployments.skew_pills]
      <div class="mt-1">
        [for models.deployments.skew_pills]
        <span class="badge text-bg-warning">[models.deployments.skew_pills]</span>
        [end]
      </div>
      [end]
    </div>
    [end]
    [end]
  </div>
  [end]
</div>

<div class="modal fade" id="modelDetailModal" tabindex="-1"
     aria-labelledby="modelDetailModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="modelDetailModalLabel">Model details</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <dl class="row small mb-0" id="modelDetailBody">
          <dt class="col-sm-3">Name</dt>
          <dd class="col-sm-9" id="mdDisplayName"></dd>
          <dt class="col-sm-3">ID</dt>
          <dd class="col-sm-9 font-monospace" id="mdModelName"></dd>
          <dt class="col-sm-3">Hosting</dt>
          <dd class="col-sm-9" id="mdHosting"></dd>
          <dt class="col-sm-3">Deployments</dt>
          <dd class="col-sm-9" id="mdMix"></dd>
          <dt class="col-sm-3">Context</dt>
          <dd class="col-sm-9 font-monospace" id="mdContext"></dd>
          <dt class="col-sm-3">License</dt>
          <dd class="col-sm-9" id="mdLicense"></dd>
          <dt class="col-sm-3">Modality</dt>
          <dd class="col-sm-9" id="mdModality"></dd>
          <dt class="col-sm-3">Openness</dt>
          <dd class="col-sm-9" id="mdOpenness"></dd>
          <dt class="col-sm-3">Thinking</dt>
          <dd class="col-sm-9" id="mdThinking"></dd>
          <dt class="col-sm-3">Notes</dt>
          <dd class="col-sm-9" id="mdNotes"></dd>
        </dl>
        <div id="mdSupplyBlock" class="mt-3 d-none">
          <h3 class="h6 text-muted">Supply path (site admins)</h3>
          <dl class="row small mb-0">
            <dt class="col-sm-3">Weights</dt>
            <dd class="col-sm-9" id="mdWeights"></dd>
            <dt class="col-sm-3">Training data</dt>
            <dd class="col-sm-9" id="mdTraining"></dd>
            <dt class="col-sm-3">Provenance record</dt>
            <dd class="col-sm-9" id="mdProvenance"></dd>
          </dl>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>
[if-any is_site_admin]
<div class="modal fade" id="approveBoxModal" tabindex="-1" aria-labelledby="approveBoxModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <form class="modal-content" method="post" action="/do-approve-box">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="approveBoxModalLabel">Approve box</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="small text-muted">Choose the models this box loads the next time it asks for its config.</p>
        <input type="hidden" name="host" id="approve-host" value="">
        [for approve_choices]
        <div class="form-check">
          <input class="form-check-input" type="checkbox" name="model" value="[approve_choices.model_name]" id="approve-[approve_choices.model_name]">
          <label class="form-check-label" for="approve-[approve_choices.model_name]">[approve_choices.display_name]</label>
        </div>
        [end]
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Approve</button>
      </div>
    </form>
  </div>
</div>
[end]
[include "footer.ezt"]
