[include "header.ezt"]
<div class="container py-4 admin-page capacity-page">
  <div class="mt-2">[include "flashes.ezt"]</div>

  <p class="small mb-2"><a href="/admin">&larr; Admin</a></p>
  <div class="d-flex justify-content-between align-items-baseline flex-wrap gap-2 mb-1">
    <h1 class="h3 mb-0">Capacity</h1>
    <div class="btn-group btn-group-sm" role="group" aria-label="Period">
      [for periods]
      <a href="/admin/capacity?days=[periods.days]" class="btn [if-any periods.active]btn-secondary[else]btn-outline-secondary[end]">[periods.days] days</a>
      [end]
    </div>
  </div>
  <p class="text-muted small mb-3">
    What each model served and what was asked of it, over the last [period_days] days: for deciding whether to rent
    more machines or return some.
  </p>

  <div class="row row-cols-2 row-cols-lg-4 g-3 mb-4">
    <div class="col"><div class="card h-100 admin-tile"><div class="card-body">
      <div class="admin-tile-figure">[fleet_cost_per_day]</div>
      <div class="admin-tile-label"><i class="bi bi-hdd-stack" aria-hidden="true"></i> Rental per day</div>
    </div></div></div>
    <div class="col"><div class="card h-100 admin-tile"><div class="card-body">
      <div class="admin-tile-figure">[fleet_tokens_per_day]</div>
      <div class="admin-tile-label"><i class="bi bi-cpu" aria-hidden="true"></i> Tokens per day, our rentals</div>
    </div></div></div>
    [if-any providers]
    <div class="col"><div class="card h-100 admin-tile"><div class="card-body">
      <div class="admin-tile-figure">[spend_month_to_date]</div>
      <div class="admin-tile-label"><i class="bi bi-cash-coin" aria-hidden="true"></i> Providers, month to date</div>
    </div></div></div>
    <div class="col"><div class="card h-100 admin-tile"><div class="card-body">
      <div class="admin-tile-figure">[spend_projected]</div>
      <div class="admin-tile-label"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i> Providers, month projected</div>
    </div></div></div>
    [end]
  </div>

  <section class="mb-4">
    [if-any capacity_down]
    <div class="alert alert-warning small">The capacity records could not be read from LiteLLM.</div>
    [end]
    [if-any demand_down]
    <div class="alert alert-warning small">The demand records could not be read from LiteLLM.</div>
    [end]
    [if-any cards]
    [for cards]
    <div class="card mb-3">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-baseline flex-wrap gap-2">
          <h2 class="h6 mb-0">
            [cards.display_name] <code class="model-id">[cards.model_name]</code>
            [if-any cards.live][else]<span class="badge text-bg-secondary ms-1">nothing serving it now</span>[end]
          </h2>
          [if-any cards.supply]
          <div class="small text-muted">
            [cards.supply.cost_per_day]/day &middot; [cards.supply.tokens_per_day] tokens/day[if-any cards.supply.usd_per_mtok] &middot;
            <span title="Rental divided by tokens served in the same hours, at the use the rentals actually had">[cards.supply.usd_per_mtok] per million tokens</span>[end]
          </div>
          [end]
        </div>

        [if-any cards.supply]
        <h3 class="cap-part small text-muted mt-3 mb-0">What it served</h3>
        <div class="row g-3 mt-0">
          <div class="col-md-4">
            <div class="cap-meter-label"><span>Busy</span><span>[cards.supply.busy]%</span></div>
            <div class="progress" style="height:8px" role="progressbar" aria-label="Busy" aria-valuenow="[cards.supply.busy]" aria-valuemin="0" aria-valuemax="100">
              <div class="progress-bar[if-any cards.supply.busy_hot] bg-warning[end]" style="width:[cards.supply.busy]%"></div>
            </div>
            <div class="small text-muted mt-1">share of the time a request was running</div>
          </div>
          [if-any cards.supply.queued]
          <div class="col-md-4">
            <div class="cap-meter-label"><span>Waiting</span><span>[cards.supply.waiting]%</span></div>
            <div class="progress" style="height:8px" role="progressbar" aria-label="Waiting" aria-valuenow="[cards.supply.waiting]" aria-valuemin="0" aria-valuemax="100">
              <div class="progress-bar[if-any cards.supply.waiting_hot] bg-danger[end]" style="width:[cards.supply.waiting]%"></div>
            </div>
            <div class="small text-muted mt-1">share of the time a request queued &middot; up to [cards.supply.waiting_peak] at once[if-any cards.supply.queue_p95] &middot; worst wait [cards.supply.queue_p95][end]</div>
          </div>
          [end]
          <div class="col-md-4">
            <div class="cap-meter-label"><span>KV cache, peak</span><span>[cards.supply.kv_peak]%</span></div>
            <div class="progress" style="height:8px" role="progressbar" aria-label="KV cache peak" aria-valuenow="[cards.supply.kv_peak]" aria-valuemin="0" aria-valuemax="100">
              <div class="progress-bar[if-any cards.supply.kv_hot] bg-warning[end]" style="width:[cards.supply.kv_peak]%"></div>
            </div>
            [if-any cards.supply.preemptions]<div class="small text-warning-emphasis mt-1">[cards.supply.preemptions] requests preempted for lack of cache</div>[end]
          </div>
        </div>

        [if-any cards.supply.token_chart]
        <div class="mt-3">
          <div class="small text-muted mb-1">Tokens per day</div>
          <div class="cap-chart" role="img" aria-label="Tokens per day for [cards.model_name]" data-chart="[cards.supply.token_chart]"></div>
        </div>
        [end]

        <table class="table table-sm small mt-3 mb-0">
          <thead><tr><th>Rental</th><th>Seen</th><th>Rental share</th><th class="text-end">Busy</th>[if-any cards.supply.servers_queued]<th class="text-end">Waiting</th>[end]<th class="text-end">KV peak</th>[if-any cards.supply.servers_preempted]<th class="text-end" title="Requests vLLM evicted from a full KV cache and ran again later">Preempted</th>[end]<th class="text-end">Tokens</th></tr></thead>
          <tbody>
            [for cards.supply.servers]
            <tr[if-any cards.supply.servers.status] class="text-muted"[end]>
              <td>[cards.supply.servers.server][if-any cards.supply.servers.label] <span class="text-muted">[cards.supply.servers.label]</span>[end]</td>
              <td>[cards.supply.servers.seen][if-any cards.supply.servers.status] <span class="badge text-bg-secondary">[cards.supply.servers.status]</span>[end]</td>
              <td>[cards.supply.servers.usd_per_hour]</td>
              <td class="text-end">[cards.supply.servers.busy]%</td>
              [if-any cards.supply.servers_queued]<td class="text-end">[cards.supply.servers.waiting]%</td>[end]
              <td class="text-end">[cards.supply.servers.kv_peak]%</td>
              [if-any cards.supply.servers_preempted]<td class="text-end[if-any cards.supply.servers.preempted] text-warning-emphasis[end]">[cards.supply.servers.preempted]</td>[end]
              <td class="text-end">[cards.supply.servers.tokens]</td>
            </tr>
            [end]
          </tbody>
        </table>
        <div class="small text-muted mt-1">
          [cards.supply.prompt_tokens] in &middot; [cards.supply.generation_tokens] out &middot; [cards.supply.requests] requests
          [if-any cards.supply.unpriced_hours]&middot; <span class="text-warning-emphasis">[cards.supply.unpriced_hours] hours unpriced</span>[end]
        </div>
        [end]

        [if-any cards.demand]
        <h3 class="cap-part small text-muted mt-3 mb-0">What was asked of it</h3>
        <div class="small text-muted mt-1">
          [cards.demand.requests_per_day] requests/day &middot; [cards.demand.prompt_tokens] in &middot; [cards.demand.completion_tokens] out
          &middot; <span title="A typical hour's median request, and the slowest hour's 95th percentile">[cards.demand.duration_p50] typical, [cards.demand.duration_p95_worst] worst hour</span>
        </div>

        [if-any cards.demand.request_chart]
        <div class="mt-3">
          <div class="small text-muted mb-1">Requests per day</div>
          <div class="cap-chart" role="img" aria-label="Requests per day for [cards.model_name]" data-chart="[cards.demand.request_chart]"></div>
        </div>
        [end]

        <div class="row small mt-3">
          <div class="col-md-3">
            <div class="text-muted">Projects</div>
            [for cards.demand.by_project]<div class="d-flex justify-content-between"><span>[cards.demand.by_project.name]</span><span>[cards.demand.by_project.requests]</span></div>[end]
          </div>
          <div class="col-md-3">
            <div class="text-muted">Tools</div>
            [for cards.demand.by_tool]<div class="d-flex justify-content-between"><span>[cards.demand.by_tool.name]</span><span>[cards.demand.by_tool.requests]</span></div>[end]
          </div>
          <div class="col-md-3">
            <div class="text-muted" title="Prompt length in tokens, successful requests">Prompt length</div>
            [for cards.demand.prompt_len]<div class="d-flex justify-content-between"><span>[cards.demand.prompt_len.name]</span><span>[cards.demand.prompt_len.count]</span></div>[end]
          </div>
          [if-any cards.demand.refused_any]
          <div class="col-md-3">
            <div class="text-muted">Refused <span class="[if-any cards.demand.refused_hot]text-danger[else]text-muted[end]">[cards.demand.refused_pct]%</span></div>
            [for cards.demand.refused]<div class="d-flex justify-content-between"><span>[cards.demand.refused.name]</span><span>[cards.demand.refused.count]</span></div>[end]
          </div>
          [end]
        </div>
        <div class="small text-muted mt-2">[cards.demand.requests] requests over [cards.demand.days] days</div>
        [end]
      </div>
    </div>
    [end]
    [else]
    <p class="text-muted small">
      No records yet for this period. Hourly records appear after an hour of sampling; a day's demand the morning after.
    </p>
    [end]
    [if-any dormant]
    <p class="small text-muted mb-0">
      Nothing serving them now, and nothing seen in the last week:
      [for dormant]
      [dormant.display_name] <code class="model-id">[dormant.model_name]</code>, last seen [dormant.last_seen][if-any dormant.cost] ([dormant.cost] over [dormant.hours] hours)[end].
      [end]
    </p>
    [end]
  </section>

  [if-any spend_down]
  <div class="alert alert-warning small">Provider spend could not be read from LiteLLM.</div>
  [end]
  [if-any providers]
  <section class="mb-4">
    <h2 class="h5 mb-2">Providers we pay</h2>
    <div class="row row-cols-1 row-cols-lg-2 g-3">
      [for providers]
      <div class="col">
        <div class="card h-100">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-baseline">
              <h3 class="h6 mb-0">[providers.provider]</h3>
              <div class="small text-muted">[providers.period] this period &middot; [providers.today] today</div>
            </div>
            <div class="small mt-3">[providers.month_to_date] so far this month, [providers.projected] by its end at this rate</div>
            [if-any providers.spend_chart]
            <div class="small text-muted mt-3 mb-1">Spend per day</div>
            <div class="cap-chart" role="img" aria-label="Spend per day with [providers.provider]" data-chart="[providers.spend_chart]"></div>
            [end]
            <div class="row small mt-3">
              <div class="col">
                <div class="text-muted">Models</div>
                [for providers.models]<div class="d-flex justify-content-between"><span>[providers.models.name]</span><span>[providers.models.usd]</span></div>[end]
              </div>
              <div class="col">
                <div class="text-muted">Projects</div>
                [for providers.projects]<div class="d-flex justify-content-between"><span>[providers.projects.name]</span><span>[providers.projects.usd]</span></div>[end]
              </div>
            </div>
          </div>
        </div>
      </div>
      [end]
    </div>
  </section>
  [end]

  <details class="small text-muted">
    <summary>How these figures are made</summary>
    <p class="mt-2 mb-0">
      Rental is the hourly price Vast or RunPod charges for each rental, counted for every hour a deployment on it was
      sampled; a rental serving two deployments splits its price between them. Tokens, busy and waiting are what was
      sampled from each deployment, every few seconds; an llmao restart loses the hour in progress. What was asked of
      a model comes from LiteLLM's log of requests, rolled up the morning after. Provider spend is LiteLLM's price at
      the time of each request, not the provider's bill.
      [if-any unpriced_hours]<strong>[unpriced_hours] hours</strong> had no price from their provider and are left out of the cost.[end]
    </p>
  </details>
</div>
<script src="/static/js/echarts.min.js"
        integrity="sha384-C2iskrW/uPW46KzOjrvJIQo4YkV8lkD+QS0CrDN18IIPIpT/g2USu8bTP3nvmIAD"></script>
[include "footer.ezt"]
