[include "header.ezt"]
<div class="container py-4 admin-page capacity-page">
  <div class="mt-2">[include "flashes.ezt"]</div>

  <p class="small mb-2"><a href="/admin">&larr; Admin</a></p>
  <div class="d-flex justify-content-between align-items-baseline flex-wrap gap-2 mb-1">
    <h1 class="h3 mb-0">Capacity</h1>
    <div class="btn-group btn-group-sm" role="group" aria-label="Period">
      [for periods]
      <a href="/admin/capacity?days=[periods.days]" class="btn [if-any periods.active]btn-secondary[else]btn-outline-secondary[end]">[periods.days] days</a>
      [end]
    </div>
  </div>
  <p class="text-muted small mb-3">
    What our boxes did and cost, and what the providers we pay were paid, over the last [period_days] days.
  </p>

  <div class="row row-cols-2 row-cols-lg-4 g-3 mb-4">
    <div class="col"><div class="card h-100 admin-tile"><div class="card-body">
      <div class="admin-tile-figure">[fleet_cost_per_day]</div>
      <div class="admin-tile-label"><i class="bi bi-hdd-stack" aria-hidden="true"></i> Rental per day</div>
    </div></div></div>
    <div class="col"><div class="card h-100 admin-tile"><div class="card-body">
      <div class="admin-tile-figure">[fleet_tokens_per_day]</div>
      <div class="admin-tile-label"><i class="bi bi-cpu" aria-hidden="true"></i> Tokens per day, our boxes</div>
    </div></div></div>
    [if-any providers]
    <div class="col"><div class="card h-100 admin-tile"><div class="card-body">
      <div class="admin-tile-figure">[spend_month_to_date]</div>
      <div class="admin-tile-label"><i class="bi bi-cash-coin" aria-hidden="true"></i> Providers, month to date</div>
    </div></div></div>
    <div class="col"><div class="card h-100 admin-tile"><div class="card-body">
      <div class="admin-tile-figure">[spend_projected]</div>
      <div class="admin-tile-label"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i> Providers, month projected</div>
    </div></div></div>
    [end]
  </div>

  <section class="mb-4">
    <h2 class="h5 mb-2">Our boxes</h2>
    [if-any capacity_down]
    <div class="alert alert-warning small">The capacity records could not be read from LiteLLM.</div>
    [end]
    [if-any models]
    [for models]
    <div class="card mb-3">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-baseline flex-wrap gap-2">
          <h3 class="h6 mb-0"><code>[models.model_name]</code></h3>
          <div class="small text-muted">
            [models.cost_per_day]/day &middot; [models.tokens_per_day] tokens/day[if-any models.usd_per_mtok] &middot;
            <span title="Rental divided by tokens served in the same hours, at the use the rentals actually had">[models.usd_per_mtok] per million tokens</span>[end]
          </div>
        </div>

        <div class="row g-3 mt-1">
          <div class="col-md-4">
            <div class="cap-meter-label"><span>Busy</span><span>[models.busy]%</span></div>
            <div class="progress" style="height:8px" role="progressbar" aria-label="Busy" aria-valuenow="[models.busy]" aria-valuemin="0" aria-valuemax="100">
              <div class="progress-bar[if-any models.busy_hot] bg-warning[end]" style="width:[models.busy]%"></div>
            </div>
            <div class="small text-muted mt-1">share of the time a request was running</div>
          </div>
          [if-any models.queued]
          <div class="col-md-4">
            <div class="cap-meter-label"><span>Waiting</span><span>[models.waiting]%</span></div>
            <div class="progress" style="height:8px" role="progressbar" aria-label="Waiting" aria-valuenow="[models.waiting]" aria-valuemin="0" aria-valuemax="100">
              <div class="progress-bar[if-any models.waiting_hot] bg-danger[end]" style="width:[models.waiting]%"></div>
            </div>
            <div class="small text-muted mt-1">share of the time a request queued &middot; up to [models.waiting_peak] at once[if-any models.queue_p95] &middot; worst wait [models.queue_p95][end]</div>
          </div>
          [end]
          <div class="col-md-4">
            <div class="cap-meter-label"><span>KV cache, peak</span><span>[models.kv_peak]%</span></div>
            <div class="progress" style="height:8px" role="progressbar" aria-label="KV cache peak" aria-valuenow="[models.kv_peak]" aria-valuemin="0" aria-valuemax="100">
              <div class="progress-bar[if-any models.kv_hot] bg-warning[end]" style="width:[models.kv_peak]%"></div>
            </div>
            [if-any models.preemptions]<div class="small text-warning-emphasis mt-1">[models.preemptions] requests preempted for lack of cache</div>[end]
          </div>
        </div>

        [if-any models.token_bars]
        <div class="mt-3">
          <div class="small text-muted mb-1">Tokens per day</div>
          <div class="cap-bars" role="img" aria-label="Tokens per day for [models.model_name]">
            [for models.token_bars]<span class="cap-bar" style="height:[models.token_bars.height]%" title="[models.token_bars.title]"></span>[end]
          </div>
        </div>
        [end]

        <table class="table table-sm small mt-3 mb-0">
          <thead><tr><th>Server</th><th>Rental share</th><th class="text-end">Busy</th>[if-any models.servers_queued]<th class="text-end">Waiting</th>[end]<th class="text-end">KV peak</th><th class="text-end">Tokens</th></tr></thead>
          <tbody>
            [for models.servers]
            <tr>
              <td class="font-monospace">[models.servers.server]</td>
              <td>[models.servers.usd_per_hour]</td>
              <td class="text-end">[models.servers.busy]%</td>
              [if-any models.servers_queued]<td class="text-end">[models.servers.waiting]%</td>[end]
              <td class="text-end">[models.servers.kv_peak]%</td>
              <td class="text-end">[models.servers.tokens]</td>
            </tr>
            [end]
          </tbody>
        </table>
        <div class="small text-muted mt-1">
          [models.prompt_tokens] in &middot; [models.generation_tokens] out &middot; [models.requests] requests &middot; [models.hours] hours sampled
          [if-any models.unpriced_hours]&middot; <span class="text-warning-emphasis">[models.unpriced_hours] hours unpriced</span>[end]
        </div>
      </div>
    </div>
    [end]
    [else]
    <p class="text-muted small">No hourly records yet for this period. The first appear after an hour of sampling.</p>
    [end]
  </section>

  <section class="mb-4">
    <h2 class="h5 mb-2">What was asked</h2>
    [if-any demand_down]
    <div class="alert alert-warning small">The demand records could not be read from LiteLLM.</div>
    [end]
    [if-any demand]
    [for demand]
    <div class="card mb-3">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-baseline flex-wrap gap-2">
          <h3 class="h6 mb-0"><code>[demand.model]</code></h3>
          <div class="small text-muted">
            [demand.requests_per_day] requests/day &middot; [demand.prompt_tokens] in &middot; [demand.completion_tokens] out
            &middot; <span title="A typical hour's median request, and the slowest hour's 95th percentile">[demand.duration_p50] typical, [demand.duration_p95_worst] worst hour</span>
          </div>
        </div>

        [if-any demand.request_bars]
        <div class="mt-3">
          <div class="small text-muted mb-1">Requests per day</div>
          <div class="cap-bars" role="img" aria-label="Requests per day for [demand.model]">
            [for demand.request_bars]<span class="cap-bar" style="height:[demand.request_bars.height]%" title="[demand.request_bars.title]"></span>[end]
          </div>
        </div>
        [end]

        <div class="row small mt-3">
          <div class="col-md-3">
            <div class="text-muted">Projects</div>
            [for demand.by_project]<div class="d-flex justify-content-between"><span>[demand.by_project.name]</span><span>[demand.by_project.requests]</span></div>[end]
          </div>
          <div class="col-md-3">
            <div class="text-muted">Tools</div>
            [for demand.by_tool]<div class="d-flex justify-content-between"><span>[demand.by_tool.name]</span><span>[demand.by_tool.requests]</span></div>[end]
          </div>
          <div class="col-md-3">
            <div class="text-muted" title="Prompt length in tokens, successful requests">Prompt length</div>
            [for demand.prompt_len]<div class="d-flex justify-content-between"><span>[demand.prompt_len.name]</span><span>[demand.prompt_len.count]</span></div>[end]
          </div>
          [if-any demand.refused_any]
          <div class="col-md-3">
            <div class="text-muted">Refused <span class="[if-any demand.refused_hot]text-danger[else]text-muted[end]">[demand.refused_pct]%</span></div>
            [for demand.refused]<div class="d-flex justify-content-between"><span>[demand.refused.name]</span><span>[demand.refused.count]</span></div>[end]
          </div>
          [end]
        </div>
        <div class="small text-muted mt-2">[demand.requests] requests over [demand.days] days</div>
      </div>
    </div>
    [end]
    [else]
    <p class="text-muted small">No demand records yet for this period. The first appear the morning after a day's traffic.</p>
    [end]
  </section>

  [if-any spend_down]
  <div class="alert alert-warning small">Provider spend could not be read from LiteLLM.</div>
  [end]
  [if-any providers]
  <section class="mb-4">
    <h2 class="h5 mb-2">Providers we pay</h2>
    <div class="row row-cols-1 row-cols-lg-2 g-3">
      [for providers]
      <div class="col">
        <div class="card h-100">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-baseline">
              <h3 class="h6 mb-0">[providers.provider]</h3>
              <div class="small text-muted">[providers.period] this period &middot; [providers.today] today</div>
            </div>
            <div class="small mt-3">[providers.month_to_date] so far this month, [providers.projected] by its end at this rate</div>
            [if-any providers.spend_bars]
            <div class="small text-muted mt-3 mb-1">Spend per day</div>
            <div class="cap-bars cap-bars-short" role="img" aria-label="Spend per day with [providers.provider]">
              [for providers.spend_bars]<span class="cap-bar" style="height:[providers.spend_bars.height]%" title="[providers.spend_bars.title]"></span>[end]
            </div>
            [end]
            <div class="row small mt-3">
              <div class="col">
                <div class="text-muted">Models</div>
                [for providers.models]<div class="d-flex justify-content-between"><span>[providers.models.name]</span><span>[providers.models.usd]</span></div>[end]
              </div>
              <div class="col">
                <div class="text-muted">Projects</div>
                [for providers.projects]<div class="d-flex justify-content-between"><span>[providers.projects.name]</span><span>[providers.projects.usd]</span></div>[end]
              </div>
            </div>
          </div>
        </div>
      </div>
      [end]
    </div>
  </section>
  [end]

  <p class="small text-muted mb-0">
    Rental is each box's hourly price from Vast or RunPod, a whole hour for every hour sampled; a box running two
    servers puts half on each. Tokens, busy and waiting are what was sampled, every few seconds; an llmao restart
    loses the hour in progress. Provider spend is LiteLLM's price at the time of each request, not the provider's bill.
    [if-any unpriced_hours]<strong>[unpriced_hours] hours</strong> had no price from their provider and are left out of the cost.[end]
  </p>
</div>
[include "footer.ezt"]
