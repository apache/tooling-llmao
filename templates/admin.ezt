[include "header.ezt"]
<div class="container py-4 admin-page">
  <div class="mt-2">[include "flashes.ezt"]</div>

  <h1 class="h3 mb-1">Admin</h1>
  <p class="text-muted small mb-3">Everything that needs a site admin, in one place.</p>
  [include "admin-nav.ezt"]

  <div class="row row-cols-2 row-cols-lg-4 g-3 mb-4">
    <div class="col">
      <a href="#work" class="card h-100 admin-tile[if-any skew_count] admin-tile-warm[end]">
        <div class="card-body">
          <div class="admin-tile-figure">[if-any skew_down]&ndash;[else][if-any skew_count][skew_count][else]0[end][end]</div>
          <div class="admin-tile-label"><i class="bi bi-wrench-adjustable" aria-hidden="true"></i> Work needed</div>
        </div>
      </a>
    </div>
    <div class="col">
      <a href="#requests" class="card h-100 admin-tile[if-any pending_count] admin-tile-hot[end]">
        <div class="card-body">
          <div class="admin-tile-figure">[if-any requests_down]&ndash;[else][if-any pending_count][pending_count][else]0[end][end]</div>
          <div class="admin-tile-label"><i class="bi bi-inbox" aria-hidden="true"></i> Awaiting your decision</div>
        </div>
      </a>
    </div>
    <div class="col">
      <a href="#approvals" class="card h-100 admin-tile[if-any approvals_soon] admin-tile-warm[end]">
        <div class="card-body">
          <div class="admin-tile-figure">[if-any requests_down]&ndash;[else][if-any approval_count][approval_count][else]0[end][end]</div>
          <div class="admin-tile-label"><i class="bi bi-key" aria-hidden="true"></i> Approvals not yet used</div>
        </div>
      </a>
    </div>
    <div class="col">
      <a href="/models" class="card h-100 admin-tile[if-any gateway_ok][else] admin-tile-warm[end]">
        <div class="card-body">
          <div class="admin-tile-figure admin-tile-figure-text">
            [if-any litellm_running][litellm_running][else]down[end]
          </div>
          <div class="admin-tile-label">
            <i class="bi [if-any litellm_matches]bi-check-circle text-success[else]bi-exclamation-triangle[end]" aria-hidden="true"></i>
            LiteLLM [if-any litellm_matches]matches the pin[else][if-any litellm_running]differs from the pin, [litellm_expected][else]unavailable[end][end]
          </div>
          [if-any disk]
          <div class="admin-tile-label">
            <i class="bi [if-any disk.low]bi-exclamation-triangle[else]bi-hdd[end]" aria-hidden="true"></i>
            [disk.free_h] of [disk.total_h] free on disk
          </div>
          [end]
        </div>
      </a>
    </div>
  </div>

  [if-any skew attention skew_down]
  <section id="work" class="mb-4">
    <h2 class="h5 mb-2">Work needed[if-any skew_count] <span class="badge text-bg-warning align-middle">[skew_count]</span>[end]</h2>
    [if-any skew_down]
    <p class="text-muted small"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Could not read LiteLLM, so what it holds is not listed.</p>
    [end]
    [if-any skew attention]
    <div class="list-group">
      [for skew]
      <div class="list-group-item d-flex justify-content-between align-items-start">
        <div>
          <div class="fw-semibold">[skew.what]</div>
          [if-any skew.since_ago]<div class="small text-muted">since <span class="llmao-hover" title="[skew.since_at]">[skew.since_ago]</span></div>[end]
        </div>
        [if-any skew.action]
        <form method="post" action="[skew.action]" class="mb-0 ms-3">
          <input type="hidden" name="subject" value="[skew.subject]">
          <button type="submit" class="btn btn-warning btn-sm">[skew.action_label]</button>
        </form>
        [end]
      </div>
      [end]
      [for attention]
      <div class="list-group-item d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
          <div class="fw-semibold">
            [if-any attention.anchor]
            <a href="/models#[attention.anchor]">[attention.ident]</a> is [attention.rest]
            [else]
            [attention.what]
            [end]
          </div>
          [if-any attention.detail]<div class="small text-muted">[attention.detail]</div>[end]
          [if-any attention.flag]<div class="small text-muted">[attention.flag]</div>[end]
        </div>
        <div class="ms-3 text-nowrap">
          [for attention.actions]
          [if-any attention.actions.is_approve]
          <button type="button" class="btn btn-sm btn-outline-primary ms-1"
                  data-bs-toggle="modal" data-bs-target="#approveRentalModal"
                  aria-label="[attention.actions.aria]"
                  data-host="[attention.actions.host]">Approve</button>
          [else]
          [if-any attention.actions.enabled]
          <form method="post" action="[attention.actions.post]" class="d-inline"[if-any attention.actions.confirm] data-confirm="[attention.actions.confirm]"[end]>
            <input type="hidden" name="host" value="[attention.actions.host]">
            [if-any attention.actions.name]
            <input type="hidden" name="name" value="[attention.actions.name]">
            [end]
            [if-any attention.actions.port]
            <input type="hidden" name="port" value="[attention.actions.port]">
            [end]
            <button type="submit" class="btn btn-sm btn-outline-secondary ms-1"[if-any attention.actions.title] title="[attention.actions.title]"[end]
                    aria-label="[attention.actions.aria]">[attention.actions.label]</button>
          </form>
          [else]
          <button type="button" class="btn btn-sm btn-outline-secondary ms-1"
                  aria-label="[attention.actions.aria]" disabled>[attention.actions.label]</button>
          <span class="text-muted small">[attention.actions.reason]</span>
          [end]
          [end]
          [end]
        </div>
      </div>
      [end]
    </div>
    <p class="small text-muted mt-1 mb-0">Each stays until it is put right. A deployment's name opens its row on Models.</p>
    [end]
  </section>
  [end]

  <section id="requests" class="mb-4">
    <h2 class="h5 mb-2">
      [if-any pending_count]
      [pending_count] [is pending_count "1"]request[else]requests[end] awaiting a decision
      [else]
      Requests
      [end]
    </h2>
    [if-any requests]
    [for requests]
    <div class="card mb-3 admin-request">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
          <div>
            <span class="fw-semibold">[requests.requester]</span>
            <span class="badge text-bg-secondary ms-1">[requests.what]</span>
            [if-any requests.project]<span class="text-muted small ms-1">[requests.project]</span>[end]
            <div class="small text-muted">asked <span class="llmao-hover" title="[requests.created_at]">[requests.created_ago]</span></div>
          </div>
          <div class="text-end">
            <div class="fw-semibold font-monospace">[requests.wanted_h]</div>
            [if-any requests.tier]<div class="small text-muted">[requests.tier] tier</div>[end]
          </div>
        </div>

        [if-any requests.reason]
        <p class="small mt-2 mb-0 fst-italic">&ldquo;[requests.reason]&rdquo;</p>
        [end]

        <div class="admin-means small mt-3">
          <i class="bi bi-info-circle" aria-hidden="true"></i>
          <strong>If you approve:</strong> [requests.means]
        </div>

        <form method="post" action="/do-decide-request" class="mt-3">
          <input type="hidden" name="request_id" value="[requests.id]">
          <div class="row g-2 align-items-center">
            [if-any requests.is_capacity]
            <div class="col-auto">
              <input class="form-control form-control-sm" type="text"
                     name="granted_token_cap" placeholder="approve this instead"
                     aria-label="Approve a different allocation" style="width:12rem">
            </div>
            [end]
            <div class="col">
              <input class="form-control form-control-sm" type="text" name="reason"
                     placeholder="Why &mdash; required [if-any requests.is_capacity]if you change the number or deny[else]to deny[end]"
                     aria-label="Reason">
            </div>
            <div class="col-auto">
              <button class="btn btn-success btn-sm" type="submit" name="decision" value="approve">
                <i class="bi bi-check-lg" aria-hidden="true"></i> Approve
              </button>
              <button class="btn btn-outline-danger btn-sm" type="submit" name="decision" value="deny">Deny</button>
            </div>
          </div>
        </form>
      </div>
    </div>
    [end]
    [else]
    [if-any requests_down]
    <p class="text-muted small"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Could not read LiteLLM.</p>
    [else]
    <p class="text-muted small"><i class="bi bi-check2-all text-success" aria-hidden="true"></i> Nothing waiting.</p>
    [end]
    [end]
  </section>

  <section id="approvals" class="mb-4">
    <h2 class="h5 mb-1">Approvals not yet used</h2>
    <p class="small text-muted mb-2">
      Each is a right to create one key, granted and not yet exercised. It lapses on its date.
    </p>
    [if-any approvals]
    <div class="list-group">
      [for approvals]
      <div class="list-group-item d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
          <i class="bi bi-key text-secondary me-1" aria-hidden="true"></i>
          <span class="fw-semibold">[approvals.requester]</span> may create [approvals.ask]
          <div class="small text-muted">approved by [approvals.decided_by] on [approvals.decided_on]</div>
        </div>
        <span class="badge [if-any approvals.soon]text-bg-warning[else]text-bg-light border[end]">lapses [approvals.expires_h]</span>
      </div>
      [end]
    </div>
    [else]
    [if-any requests_down]
    <p class="text-muted small"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Could not read LiteLLM.</p>
    [else]
    <p class="text-muted small">None outstanding.</p>
    [end]
    [end]
  </section>

  <section id="recent" class="mb-4">
    <div class="d-flex justify-content-between align-items-baseline flex-wrap gap-2 mb-2">
      <h2 class="h5 mb-0">Recent work <span class="small text-muted fw-normal">last [recent_days] days</span></h2>
      <div class="btn-group btn-group-sm" role="group" aria-label="Whose work">
        <a href="/admin#recent" class="btn [if-any recent_mine]btn-outline-secondary[else]btn-secondary[end]">Everyone</a>
        <a href="/admin?who=me#recent" class="btn [if-any recent_mine]btn-secondary[else]btn-outline-secondary[end]">Just me</a>
      </div>
    </div>
    [if-any recent]
    <ul class="list-unstyled admin-timeline mb-0">
      [for recent]
      <li class="admin-timeline-item">
        <i class="bi [recent.icon] admin-timeline-icon" aria-hidden="true"></i>
        <div>
          <div>[recent.sentence]</div>
          <div class="small text-muted">[recent.by] &middot; <span class="llmao-hover" title="[recent.at]">[recent.ago]</span></div>
        </div>
      </li>
      [end]
    </ul>
    [else]
    <p class="text-muted small">Nothing in the last [recent_days] days.</p>
    [end]
  </section>

</div>
<div class="modal fade" id="approveRentalModal" tabindex="-1" aria-labelledby="approveRentalModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <form class="modal-content" method="post" action="/do-approve-rental">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="approveRentalModalLabel">Approve rental</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="small text-muted">Choose the models this rental loads the next time it asks for its config.</p>
        <input type="hidden" name="host" id="approve-host" value="">
        [for approve_choices]
        <div class="form-check">
          <input class="form-check-input" type="checkbox" name="model" value="[approve_choices.model_name]" id="approve-[approve_choices.model_name]">
          <label class="form-check-label" for="approve-[approve_choices.model_name]">[approve_choices.display_name]</label>
        </div>
        [end]
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Approve</button>
      </div>
    </form>
  </div>
</div>
[include "footer.ezt"]
