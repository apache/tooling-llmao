[include "header.ezt"]
<div class="container py-4">
  <div class="mt-2">[include "flashes.ezt"]</div>

  <h1 class="h3 mb-3">Admin</h1>
  <p class="text-muted small">
    Everything that needs a site admin, in one place.
  </p>

  [if-any skew]
  <div class="card border-warning mb-3">
    <div class="card-header fw-semibold">Work needed</div>
    <ul class="list-group list-group-flush">
      [for skew]
      <li class="list-group-item small">
        <span class="fw-semibold">[skew.what]</span>
        <span class="text-muted">&middot; [skew.about][if-any skew.since] &middot; since [skew.since][end]</span>
      </li>
      [end]
    </ul>
    <div class="card-footer small text-muted">
      Each of these stays until it is put right.
    </div>
  </div>
  [end]

  [if-any log]
  <div class="card mb-3">
    <div class="card-header fw-semibold">For your attention</div>
    <ul class="list-group list-group-flush">
      [for log]
      <li class="list-group-item small d-flex justify-content-between align-items-start">
        <div>
          [log.what]
          <span class="text-muted">[if-any log.times]&middot; [log.times] [end][if-any log.when]&middot; [log.when][end]</span>
        </div>
        <form method="post" action="/do-acknowledge" class="mb-0 ms-3">
          <input type="hidden" name="key" value="[log.key]">
          <input type="hidden" name="after_path" value="/admin">
          <button type="submit" class="btn btn-outline-secondary btn-sm">Acknowledge</button>
        </form>
      </li>
      [end]
    </ul>
  </div>
  [end]

  <div class="list-group">
    <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-start"
       href="/admin/requests">
      <div>
        <div class="fw-semibold">Requests</div>
        <div class="small text-muted">
          Capacity bumps and key requests awaiting a decision.
        </div>
      </div>
      [if-any pending_count]
      <span class="badge text-bg-danger rounded-pill">[pending_count]</span>
      [end]
    </a>
    <a class="list-group-item list-group-item-action" href="/admin/tiers">
      <div class="fw-semibold">Tiers</div>
      <div class="small text-muted">
        Allowances and rate limits per tier. Applies to every key on the tier.
      </div>
    </a>
    <a class="list-group-item list-group-item-action" href="/admin/at-limit">
      <div class="fw-semibold">At the limit</div>
      <div class="small text-muted">
        Keys at or near their allowance, oldest first.
      </div>
    </a>
    <a class="list-group-item list-group-item-action" href="/keys/other">
      <div class="fw-semibold">Service keys</div>
      <div class="small text-muted">
        Every key with no human at the keyboard, and when it was last used.
      </div>
    </a>
  </div>

  <div class="card mt-4">
    <div class="card-body py-2 small">
      <div class="fw-semibold">LiteLLM</div>
      [if-any litellm_running]
      [if-any litellm_matches]
      [litellm_running], matches the pin.
      [else]
      Running [litellm_running]. The pin is [litellm_expected].
      [end]
      [else]
      Unavailable.
      [end]
    </div>
  </div>
</div>
[include "footer.ezt"]
