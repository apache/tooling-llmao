[if-any flashes]
[for flashes]
[is flashes.category "raw"]
<div class="alert alert-warning alert-dismissible show" role="alert">
  [format "raw"][flashes.message][end]
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
[else]
<div class="alert alert-[flashes.category] alert-dismissible show" role="alert">
  [flashes.message]
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
[end]
[end]
[end]
[if-any work]
<div class="alert alert-warning py-2 small d-flex justify-content-between align-items-center" role="alert">
  <div><strong>Work needed.</strong> [work.what]</div>
  <a class="btn btn-outline-dark btn-sm ms-3" href="[work.href]">Go to [work.label]</a>
</div>
[end]
[if-any notices]
<div class="card border-info mb-3">
  <div class="card-header py-2 small fw-semibold">Notices</div>
  <ul class="list-group list-group-flush">
    [for notices]
    <li class="list-group-item d-flex justify-content-between align-items-start small">
      <div>
        [notices.what]
        <span class="text-muted">[if-any notices.times]&middot; [notices.times] [end][if-any notices.when]&middot; [notices.when][end]</span>
      </div>
      <form method="post" action="/do-acknowledge" class="mb-0 ms-3">
        <input type="hidden" name="key" value="[notices.key]">
        <button type="submit" class="btn btn-outline-secondary btn-sm">Acknowledge</button>
      </form>
    </li>
    [end]
  </ul>
  <div class="card-footer py-1 small text-muted">
    Each of these stays until you acknowledge it.
  </div>
</div>
[end]
