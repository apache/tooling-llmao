[include "header.ezt"]
<div class="container py-4">
  <div class="mt-2">[include "flashes.ezt"]</div>
  <div class="row">
    <nav class="col-lg-3 mb-4" aria-label="Help">
      <h2 class="h6">Help</h2>
      <ul class="list-unstyled small">
        <li><a href="/help">Overview</a></li>
        [for articles]
        <li><a href="/help/[articles.slug]">[articles.title]</a></li>
        [end]
      </ul>
    </nav>
    <div class="col-lg-9">
      [format "raw"][body][end]
    </div>
  </div>
</div>
[include "footer.ezt"]
