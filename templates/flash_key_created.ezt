<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>

<h4 class="alert-heading d-flex align-items-center gap-2 mb-1">
  <i class="bi bi-key-fill" style="font-size:18px"></i>
  [if-any is_automation]
    Automation
  [else]
    Personal
  [end]
  API key created
</h4>
<p class="mb-3">Copy this secret now. It <strong>will not be shown again</strong>.</p>

<div class="input-group mb-1">
  <input type="text" readonly class="form-control font-monospace bg-white js-secret-field"
         value="[secret]" onclick="this.select()">
  <button class="btn btn-outline-dark d-flex align-items-center gap-1 js-copy-btn" type="button">
    <i class="bi bi-clipboard js-copy-icon"></i>
    <span class="js-copy-label">Copy</span>
  </button>
</div>
<div class="small mb-3 js-copy-status" role="status" aria-live="polite" style="min-height: 18px; color: #146c43;"></div>

[if-any is_automation]
<div class="small mb-2">
  You are recorded as <strong>created_by: [created_by]</strong>. Teammates cannot recover this
  secret from llmao — they will contact you for it.
</div>
[end]

<div class="small text-muted border-top pt-2" style="border-color: rgba(0,0,0,.15) !important;">
  <span class="me-3"><strong>Project</strong> [project]</span>
  <span><strong>Purpose</strong> [purpose]</span>
</div>
