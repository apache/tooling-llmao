[include "header.ezt"]
<div class="container py-4" style="max-width: 36rem;">
  <div class="mt-2">[include "flashes.ezt"]</div>

  <h1 class="h3 mb-3">Create personal key</h1>
  <p class="text-muted small">
    The secret is shown <strong>once</strong> after creation. Store it in your
    password manager or secrets system.
  </p>

  [if-any error]
  <div class="alert alert-danger">[error]</div>
  [end]

  <form method="post" action="/keys/new" class="vstack gap-3">
    <div>
      <label class="form-label" for="project">Project</label>
      <select class="form-select" name="project" id="project" required>
        <option value="">Select project…</option>
        [for projects]
        <option value="[projects.name]">[projects.name]</option>
        [end]
      </select>
    </div>
    <div>
      <label class="form-label" for="purpose">Purpose</label>
      <input class="form-control" type="text" name="purpose" id="purpose"
             required maxlength="128" placeholder="e.g. laptop-cli, local-dev"
             value="[form_purpose]">
      <div class="form-text">Short label for this key (required).</div>
    </div>
    <div class="d-flex gap-2">
      <button type="submit" class="btn btn-primary">Create key</button>
      <a class="btn btn-outline-secondary" href="/keys">Cancel</a>
    </div>
  </form>
</div>
[include "footer.ezt"]
