# ---------------------------------------------------------------------------
# llmao — generated, runtime, and local-only files
# ---------------------------------------------------------------------------

# Runtime state written by the app (StateStore) and its atomic-write temp files.
# Default path is ./llmao-state.json; LLMAO_STATE_PATH may point elsewhere.
llmao-state.json
demo-state.json
*-state.json
*.tmp

# Local secrets / environment overrides (commit .env.example, never .env)
.env
.env.*
!.env.example

# asfquart app config (secrets) and session encryption token — use *.example
config.yaml
apptoken.txt

# LiteLLM proxy config with secrets — use litellm.yaml.example
litellm.yaml

# Model inventory with provider keys (api_base is cleartext; keys from eyaml)
# use model_list.yaml.example
model_list.yaml

# Fleet membership, written by the app at runtime (fleet_path).
# Puppet seeds it with `replace => false`; contents are never in the repo.
fleet.yaml

# third-party fetch scratch (bin/fetch-thirdparty.sh)
bin/*.zip

# Legacy generated litellm/ tree (prefer root litellm.yaml)
# litellm/config.yaml

# Uploaded-file scratch / screenshot output, if produced locally
/uploads/
/shots/
/screenshots/
*.png.tmp

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging / build artifacts
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# Test / coverage / type-checker caches
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.cache/
.mypy_cache/
.ruff_cache/
.tox/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
