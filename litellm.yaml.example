# LiteLLM proxy config for llmao.
# Copy to litellm.yaml (gitignored) and replace CHANGE_ME_* values.
#
#   cp litellm.yaml.example litellm.yaml
#   ./bin/gen-litellm-master-key.sh   # print sk-…; paste into config.yaml + litellm.yaml
#   make proxy                       # litellm --config litellm.yaml
#
# Do not include models.yaml. That file is admin definitions (UX + vLLM recipe).
# Deployments live in Postgres (store_model_in_db) and are pushed by llmao
# (/model/new). Including it would create deployments with no api_base
# (LiteLLM then sends traffic to api.openai.com). Self-host litellm_params
# use hosted_vllm/, not openai/.
#
# Production secrets: Puppet/eyaml. Puppet may also set STORE_MODEL_IN_DB in
# the process env; the YAML flag below is what local `make proxy` uses.

litellm_settings:
  drop_params: true
  # Rejects a 200 that carries no answer, with a message saying what to do.
  # A reasoning model emits its thinking into the SAME budget as the reply,
  # so too small a max_tokens returns finish_reason "length" and EMPTY
  # content -- a success at the HTTP layer that no client can interpret.
  # Measured on qwen3.8-27b: nothing at all below ~3000 tokens, at every
  # reasoning_effort. See litellm_hooks.py.
  #
  # Production sets this through the same file Puppet writes.
  callbacks: ["litellm_hooks.empty_completion_guard"]

general_settings:
  # Proxy admin key (must start with sk-). Same value as config.yaml → litellm.master_key.
  master_key: CHANGE_ME_MASTER_KEY
  # Required for virtual keys, teams, budgets, and spend tracking.
  # Developer: run `make db` (bin/setup_litellm_db.py) against system Postgres
  # and paste the printed database_url here. Production: Puppet/eyaml.
  database_url: postgresql://llmao:CHANGE_ME@127.0.0.1:5432/litellm
  store_model_in_db: true
