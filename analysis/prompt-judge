"""A model's verdict on each cluster: Foundation work or not, the tier that would do, the activity.

    sudo ./analysis/prompt-judge                  # dry run: the first request it would send, the count
    sudo ./analysis/prompt-judge --judge          # send them, one at a time, then list
    sudo ./analysis/prompt-judge --judge --days 30 --limit 20   # at most 20 calls this run
    sudo ./analysis/prompt-judge --findings       # the listing only
    sudo ./analysis/prompt-judge --findings --json

Reads the clusters prompt-clusters stored for the span. Without --judge
it is a dry run: it prints the request it would send first and how many
clusters lack a verdict, and sends nothing. With --judge it sends the
gateway one request per cluster that has no verdict yet from this judge
prompt (analysis/judge-prompt.md), this model and this exemplar. Each
verdict is written as it returns, so a run that stops keeps what it
judged. One request in flight, through the front door, with the service
key in config.yaml analysis_key; the model is analysis_model.

The listing is every cluster of the span with its verdict: a cluster the
judge called non-Foundation work, or served by a lower tier than the
model it used, is what an admin reads it for.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import pathlib
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import _core

from llmao import fmt

OPENING_SHOWN = 48


def _findings(clusters: list, days: list[dt.date]) -> None:
    span = f"{days[0]} to {days[-1]}" if len(days) > 1 else str(days[0])
    judged = sum(1 for c in clusters if c.verdict)
    print(f"{fmt.plural(len(clusters), 'cluster')} over {span}, {judged} with a verdict\n")
    columns = ["fingerprint", "project", "who", "tool", "requests", "asf", "tier", "activity", "models", "opening"]
    rows = []
    for c in clusters:
        v = c.verdict
        models = ", ".join(f"{m} {n}" for m, n in sorted(c.models.items(), key=lambda kv: -kv[1]))
        start = c.opening[:OPENING_SHOWN] + ("…" if len(c.opening) > OPENING_SHOWN else "")
        rows.append(
            [
                c.fingerprint,
                c.project,
                c.who,
                c.tool,
                f"{c.requests:,}",
                v.asf_work if v else "-",
                v.tier if v else "-",
                v.activity if v else ("-" if c.exemplar_hash else "(no exemplar)"),
                models,
                start,
            ]
        )
    widths = [max(len(col), *(len(r[i]) for r in rows)) if rows else len(col) for i, col in enumerate(columns)]

    def line(values):
        return "  ".join(
            v.rjust(w) if i == 4 else v.ljust(w) for i, (v, w) in enumerate(zip(values, widths, strict=True))
        )

    print(line(columns))
    print(line(["-" * w for w in widths]))
    for r in rows:
        print(line(r))
    print()
    for c in clusters:
        if c.verdict and c.verdict.reason:
            print(f"{c.fingerprint}  {c.verdict.reason}")


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--days", type=int, default=7, help="the last N closed UTC days (default %(default)s)")
    ap.add_argument("--from", dest="start", type=dt.date.fromisoformat, help="first day, instead of --days")
    ap.add_argument("--to", dest="end", type=dt.date.fromisoformat, help="last day (default: yesterday)")
    ap.add_argument("--analysis-dir", type=pathlib.Path, default=None, help="where the store lives")
    ap.add_argument("--judge", action="store_true", help="send the requests; without it nothing is sent")
    ap.add_argument("--limit", type=int, default=None, help="at most this many calls this run")
    ap.add_argument("--findings", action="store_true", help="the listing only")
    ap.add_argument("--json", action="store_true", help="the clusters with their verdicts as JSON")
    args = ap.parse_args(argv)
    try:
        days = _core.span(days=args.days, start=args.start, end=args.end)
    except ValueError:
        ap.error("--from is after --to")

    prompt = _core.judge_prompt()
    settings = _core.judge_settings() if args.judge else None
    model = settings.model if settings else _core.DEFAULT_MODEL
    store = _core.Store(args.analysis_dir or _core.analysis_dir())
    try:
        clusters = list(store.clusters_over(days))
        if not args.findings:
            todo = store.stale(clusters, prompt.hash, model)
            if args.limit is not None:
                todo = todo[: args.limit]
            if not args.judge:
                if todo:
                    print(json.dumps(_core.judge_request(todo[0], prompt, model), indent=1))
                print(f"\n{fmt.plural(len(todo), 'cluster')} to judge; nothing sent without --judge", file=sys.stderr)
                return 0
            for i, c in enumerate(todo, 1):
                try:
                    verdict = _core.parse_verdict(_core.ask(settings, _core.judge_request(c, prompt, model)))
                except _core.JudgeError as e:
                    raise SystemExit(f"{c.fingerprint}: {e}") from None
                store.write_verdict(c, prompt.hash, model, verdict)
                said = f"{verdict.asf_work} {verdict.tier} {verdict.activity}"
                print(f"{i}/{len(todo)} {c.fingerprint} {said}", file=sys.stderr)
        clusters = list(store.with_verdicts(clusters, prompt.hash, model))
        if args.json:
            json.dump(clusters, sys.stdout, indent=1)
            sys.stdout.write("\n")
        else:
            _findings(clusters, days)
    finally:
        store.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
