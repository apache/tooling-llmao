"""The prompt log's analysis, one entry point: `prompts <command> --help` for each.

Build the store, then read it:

    sudo ./analysis/prompts build       # cluster the span's day files into the store
    sudo ./analysis/prompts judge       # the judges' verdicts on the clusters that lack one (dry run; --judge sends)

    sudo ./analysis/prompts report      # who asks what of which model, no content, from the day files
    sudo ./analysis/prompts clusters    # who is sending what kind of request, over the span
    sudo ./analysis/prompts show <fp>   # one cluster, exemplar in full
    sudo ./analysis/prompts verdicts    # the judges' consensus per cluster, where they split
    sudo ./analysis/prompts tiers       # what was used against what the judges say would do

The commands share --days, --from and --to for the span of closed UTC
days, and read config.yaml beside this directory (docs/analysis-design.md).
build and judge are the only ones that write. Every command's arguments
are defined here; the modules do the work.
"""

from __future__ import annotations

import argparse
import datetime as dt
import os
import pathlib
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import _clusters
import _judge
import _report


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="command", required=True, metavar="command")

    def command(
        name: str, run, help_text: str, description: str, *, span=True, store=True, log_dir=False
    ) -> argparse.ArgumentParser:
        """One subcommand, with the arguments most of them share: the span of days, the store, the log directory."""
        p = sub.add_parser(name, help=help_text, description=description)
        p.set_defaults(run=run, parser=p)
        if span:
            p.add_argument("--days", type=int, default=7, help="the last N closed UTC days (default %(default)s)")
            p.add_argument("--from", dest="start", type=dt.date.fromisoformat, help="first day, instead of --days")
            p.add_argument("--to", dest="end", type=dt.date.fromisoformat, help="last day (default: yesterday)")
        if log_dir:
            p.add_argument("--log-dir", type=pathlib.Path, default=None, help="the prompt log directory")
        if store:
            p.add_argument("--analysis-dir", type=pathlib.Path, default=None, help="where the store lives")
        return p

    p = command(
        "build",
        _clusters.run_build,
        "cluster the span's day files into the store",
        "Writes the store: each day of the span it has not seen is read and its records clustered, "
        "and what is past the retention is pruned. A day is read once; --rebuild reads them all again.",
        log_dir=True,
    )
    p.add_argument("--rebuild", action="store_true", help="forget every day and cluster, read the span again")

    p = command(
        "clusters",
        _clusters.run_clusters,
        "who is sending what kind of request, over the span",
        "Lists the store's clusters over the span: project, person, tool, requests, token figures, "
        "models used, and the opening of the instructions.",
    )
    p.add_argument("--json", action="store_true", help="the clusters over the span as JSON, exemplars included")

    p = command(
        "show",
        _clusters.run_show,
        "one cluster, exemplar in full",
        "Prints one cluster: its opening, and the exemplar the judges read, head and messages in full.",
        span=False,
    )
    p.add_argument("fingerprint", help="the cluster, as the listings print it")

    p = command(
        "report",
        _report.run,
        "who asks what of which model, no content",
        "Reads the day files, never the store, and prints the reports that need no prompt content: "
        "requests and tokens by project, user, model and tool; prompt lengths; shares; failures; "
        "messages per request.",
        store=False,
        log_dir=True,
    )
    p.add_argument("--csv", action="store_true", help="CSV, one block per report, instead of text")

    p = command(
        "judge",
        _judge.run_judge,
        "the judges' verdicts on the clusters that lack one",
        "Writes the store: asks each judge the three questions about every cluster of the span that has no "
        "verdict from it yet, one request at a time, and ends with a summary and what to run next. "
        "A dry run unless --judge is given: the clusters to judge, which judges each lacks, the calls and "
        "the time they take, and where they go.",
    )
    p.add_argument("--judge", action="store_true", help="send the requests; without it nothing is sent")
    p.add_argument("--request", action="store_true", help="in the dry run, also print the first request as JSON")
    p.add_argument("--limit", type=int, default=None, help="at most this many calls per judge this run")
    p.add_argument("--model", action="append", default=None, help="a judge, instead of analysis_models; repeatable")

    p = command(
        "verdicts",
        _judge.run_verdicts,
        "the judges' consensus per cluster, where they split",
        "Lists every cluster of the span with what its judges together say: Foundation work, tier, activity, "
        "and the number of judges, with a mark where they did not all agree.",
    )
    p.add_argument("--compare", action="store_true", help="each judge's answers, on the clusters where they differ")
    p.add_argument("--reasons", action="store_true", help="each judge's reason, cluster by cluster")
    p.add_argument("--json", action="store_true", help="the clusters with their verdicts as JSON")

    _ = command(
        "tiers",
        _judge.run_tiers,
        "what was used against what the judges say would do",
        "For each judged cluster, the consensus tier, the model that tier recommends, the models the cluster "
        "used, and how many requests went to a heavier model than the work needs, or a lighter one.",
    )

    args = ap.parse_args(argv)
    return args.run(args.parser, args)


if __name__ == "__main__":
    sys.exit(main())
