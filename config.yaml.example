# Copy to config.yaml and edit. config.yaml is gitignored (may hold secrets).
#
#   cp config.yaml.example config.yaml
#   cp litellm.yaml.example litellm.yaml
#   ./bin/gen-litellm-master-key.sh   # paste same sk-… into config.yaml + litellm.yaml
#
# config.yaml and litellm.yaml are required (copy from *.example; secrets).
# models.yaml is committed (no secrets). Do not join the two secret files.
# Do not include models.yaml from litellm.yaml. Production: Puppet/hiera/eyaml
# writes secrets into on-disk YAML. Not environment variables.

server:
  # Port for the asfquart process. Behind a reverse proxy in production.
  port: 8443

  # PEM files relative to certs/ (see certs/README.md), or absolute paths.
  # Leave both blank for plain HTTP (e.g. behind a reverse proxy with TLS).
  # Local OAuth needs HTTPS + localhost.apache.org — use mkcert as documented.
  certfile: localhost.apache.org+3.pem
  keyfile: localhost.apache.org+3-key.pem

litellm:
  # Always talks to a real LiteLLM admin API (same shape as production).
  # Local: make db && make proxy (system Postgres + litellm.yaml).
  base_url: http://127.0.0.1:4000
  # Same value as litellm.yaml → general_settings.master_key (must start with sk-).
  # Bearer token for /team/* and /key/* from this process.
  master_key: CHANGE_ME_MASTER_KEY
  request_timeout_s: 30

budgets:
  default_team_budget_usd: 100
  duration: 30d

# uids that may view any project's activity (plus asfquart isRoot)
site_admins: []


# Admin model definitions (UX + vLLM recipe + /model/new template).
# Not included by litellm.yaml. Relative to app root.
models_path: models.yaml

# Shared secret GPU boxes present as Authorization: Bearer when fetching
# GET /vllm/config. Bake FLEET_KEY into the Vast template (not instance env).
# Placement is keyed by the box public IP (request.remote_addr / X-Forwarded-For).
fleet:
  key: CHANGE_ME_FLEET_KEY
  # HMAC secret for each vLLM --api-key. This file and Puppet eyaml only.
  # Never the Vast template. GET /vllm/config returns sk-vllm-… from this
  # salt plus host and listen port. A missing attribute fails fleet build.
  # Changing it invalidates every box bearer. See docs/fleet-state.md §2.3.
  vllm_api_salt: CHANGE_ME_VLLM_API_SALT
  # Legacy shared bearer. The fleet path does not read this. Left so existing
  # configs still parse until Puppet drops llmao::selfhost_api_key.
  selfhost_api_key: CHANGE_ME_SELFHOST_API_KEY
  # Seconds between vLLM GET /health probes (unauthenticated; private path only).
  health_interval_s: 45
  # Per-probe HTTP timeout for vLLM /health.
  health_timeout_s: 3
  # After first observation, stay "starting" this long before treating never-up as down.
  health_grace_s: 1800
  # Consecutive failed probes before a previously healthy server is marked down.
  health_fail_threshold: 3
  # Seconds between LiteLLM /model/info vs fleet.hosts config-skew checks.
  skew_interval_s: 180
  # Seconds between LiteLLM GET /health (real completions; tokens) vs fleet probe state.
  litellm_health_interval_s: 14400
  # Host row port is the container listen port (vLLM --port / box JSON).
  # Without fleet.vast, the public port equals the listen port (local).
  # fleet.hosts is loaded once at process start. Standalone (runx) watches
  # config.yaml and reloads. Production: Puppet restart after a change.
  # Production: set fleet.vast.api_key (gitignored config.yaml). Lifecycle
  # fetches Vast HostPorts; never send those to the box.
  # vast:
  #   api_key: CHANGE_ME_VAST_API_KEY
  hosts:
    127.0.0.1:
      - [gemma4-26b, 8001]
      - [qwen3-8b, 8003]
