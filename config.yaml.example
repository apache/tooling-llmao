# Copy to config.yaml and edit. config.yaml is gitignored (may hold secrets).
#
#   cp config.yaml.example config.yaml
#   cp litellm.yaml.example litellm.yaml
#   ./bin/gen-litellm-master-key.sh   # paste same sk-… into config.yaml + litellm.yaml
#
# config.yaml and litellm.yaml are required (copy from *.example; secrets).
# models.yaml is committed (no secrets). Do not join the two secret files.
# Do not include models.yaml from litellm.yaml. Production: Puppet/hiera/eyaml
# writes secrets into on-disk YAML. Not environment variables.

server:
  # Port for the asfquart process. Behind a reverse proxy in production.
  port: 8443

  # PEM files relative to certs/ (see certs/README.md), or absolute paths.
  # Leave both blank for plain HTTP (e.g. behind a reverse proxy with TLS).
  # Local OAuth needs HTTPS + localhost.apache.org — use mkcert as documented.
  certfile: localhost.apache.org+3.pem
  keyfile: localhost.apache.org+3-key.pem

litellm:
  # Always talks to a real LiteLLM admin API (same shape as production).
  # Local: make db && make proxy (system Postgres + litellm.yaml).
  base_url: http://127.0.0.1:4000
  # Same value as litellm.yaml → general_settings.master_key (must start with sk-).
  # Bearer token for /team/* and /key/* from this process.
  master_key: CHANGE_ME_MASTER_KEY
  request_timeout_s: 30

budgets:
  default_team_budget_usd: 100
  duration: 30d
  # Weekly token allocation a project starts with. Capacity, not money --
  # self-hosted tokens cost the fleet the same whether drawn or idle, so this
  # is a share of throughput rather than a spending limit.
  #
  # Deliberately generous for the pilot. A cap that binds generates support
  # requests and teaches us nothing; one that rarely binds measures what
  # people actually draw, which is the input to whatever replaces it.
  #
  # The fleet serves roughly 9.1 billion tokens a month at a 50% planning
  # utilisation, so twenty projects at 20M/week is about 7% of capacity.
  default_team_token_cap: 20000000

# Entitlements: what a key may do, as distinct from what it may spend.
#
# A budget is a dollar ceiling and only binds where dollars are real --
# commercial providers. Self-hosted models have no marginal cost, so their
# spend accrues at a derived price for reporting and never exhausts anything.
# Rate limits are therefore the ONLY control on self-hosted capacity, and a
# key minted without them can saturate the fleet with nothing to stop it.
#
# Every value here is applied at key creation. LiteLLM has no usable default:
# absent means unlimited.
entitlements:
  # Applies to every key unless a tier below overrides it.
  default:
    # Requests and tokens per minute. tpm is the one that bites on a
    # self-hosted box -- a single 40k-token audit call is most of a minute's
    # budget at 60k.
    rpm_limit: 60
    tpm_limit: 60000
    # Concurrent in-flight requests. The binding constraint at peak: the
    # weakest box in the fleet admits about four before queueing, so a single
    # key holding eight is already more than its share.
    max_parallel_requests: 4

  # Personal keys, no project. Self-hosted models only -- commercial access
  # needs an owner who can be asked about the bill, and a PMC is that owner.
  free_tier:
    rpm_limit: 30
    tpm_limit: 30000
    max_parallel_requests: 2
    # Rolling allowance, kept as daily buckets: sum the last N days, drop the
    # rest. No calendar reset, so there is no boundary to straddle and no
    # instant where everyone's counter drops at once.
    #
    # Not a daily entitlement. One allowance, and the daily shape is emergent
    # -- a committer can spend the week's share in an hour and then wait,
    # which is how people actually work.
    #
    # These are the two values an RAI admin is most likely to move. They can
    # be changed at runtime from the admin page; config is the starting value
    # and the fallback when nothing is stored.
    token_cap: 1000000
    token_window_days: 7

  # Project keys draw on the project's allocation. PMC distributes.
  project:
    rpm_limit: 120
    tpm_limit: 120000
    max_parallel_requests: 8

  # Overrides an RAI admin has set at runtime live in LiteLLM team metadata
  # for project tiers, and in llmao's own store for the free tier -- not here.
  # config.yaml is the default and the fallback, so a fresh deployment has
  # working limits before anyone touches the admin page.

  # Service keys for pipelines. Higher throughput, and the tier most likely
  # to retry in a loop -- which is exactly why it still has a ceiling.
  service:
    rpm_limit: 240
    tpm_limit: 300000
    max_parallel_requests: 8

# uids that may view any project's activity (plus asfquart isRoot)
# How often to sample each box's queue depth, in seconds. 0 turns it off.
#
# The spend log records what RAN and cannot record what WAITED -- queue depth
# only exists while it is happening. Without this, the question of whether
# free-tier and project work ever actually contend for a GPU is unanswerable
# after the fact.
#
# One HTTP GET per self-hosted box per interval, one JSON line per box on the
# llmao.contention logger. At three boxes and fifteen seconds that is about
# 17,000 lines a day; jq answers every question we currently have of it.
contention_interval_s: 15

site_admins: []


# Admin model definitions (UX + vLLM recipe + /model/new template).
# Not included by litellm.yaml. Relative to app root.
models_path: models.yaml

# Shared secret GPU boxes present as Authorization: Bearer when fetching
# GET /vllm/config. Bake FLEET_KEY into the Vast template (not instance env).
# Placement is keyed by the box public IP (request.remote_addr / X-Forwarded-For).
fleet:
  key: CHANGE_ME_FLEET_KEY
  # HMAC secret for each vLLM --api-key. This file and Puppet eyaml only.
  # Never the Vast template. GET /vllm/config returns sk-vllm-… from this
  # salt plus host and listen port. A missing attribute fails fleet build.
  # Changing it invalidates every box bearer. See docs/fleet-state.md §2.3.
  vllm_api_salt: CHANGE_ME_VLLM_API_SALT
  # Legacy shared bearer. The fleet path does not read this. Left so existing
  # configs still parse until Puppet drops llmao::selfhost_api_key.
  selfhost_api_key: CHANGE_ME_SELFHOST_API_KEY
  # Seconds between vLLM GET /health probes (unauthenticated; private path only).
  health_interval_s: 45
  # Per-probe HTTP timeout for vLLM /health.
  health_timeout_s: 3
  # After first observation, stay "starting" this long before treating never-up as down.
  health_grace_s: 1800
  # Consecutive failed probes before a previously healthy server is marked down.
  health_fail_threshold: 3
  # Seconds between LiteLLM /model/info vs fleet.hosts config-skew checks.
  skew_interval_s: 180
  # Seconds between LiteLLM GET /health (real completions; tokens) vs fleet probe state.
  litellm_health_interval_s: 14400
  # Host row port is the container listen port (vLLM --port / box JSON).
  # Without fleet.vast, the public port equals the listen port (local).
  # fleet.hosts is loaded once at process start. Standalone (runx) watches
  # config.yaml and reloads. Production: Puppet restart after a change.
  # Production: set fleet.vast.api_key (gitignored config.yaml). Lifecycle
  # fetches Vast HostPorts; never send those to the box.
  # vast:
  #   api_key: CHANGE_ME_VAST_API_KEY
  hosts:
    127.0.0.1:
      - [gemma4-26b, 8001]
      - [qwen3-8b, 8003]
