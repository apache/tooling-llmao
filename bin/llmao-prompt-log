"""The prompt log, read at a shell on the gateway host.

    sudo uv run bin/llmao-prompt-log report                 # the last 7 closed days
    sudo uv run bin/llmao-prompt-log report --days 30
    sudo uv run bin/llmao-prompt-log report --from 2026-11-01 --to 2026-11-03 --csv
    sudo uv run bin/llmao-prompt-log rollup --json 2026-11-01

Reads the day files the proxy's hook writes (docs/prompt-logging-design.md)
and nothing else: never a connection to LiteLLM, never a write in the log
directory. `rollup --json` is what the portal's demand-rollup runner
spawns for each day it rolls up; the reports are for a person. None of
the reports reads prompt content: requests and prompt tokens by project,
user, model and tool; prompt length per model; the share of requests
that stream, carry tools or end at max_tokens; failures by class; and
messages per request.

The log directory is --log-dir, else prompt_log_dir from config.yaml in
the current directory, else ./prompt-log.
"""

from __future__ import annotations

import argparse
import csv
import datetime as dt
import json
import pathlib
import sys

import yaml

from llmao import fmt, prompt_log


def _default_log_dir() -> pathlib.Path:
    cfg = pathlib.Path("config.yaml")
    if cfg.exists():
        raw = (yaml.safe_load(cfg.read_text()) or {}).get("prompt_log_dir")
        if raw:
            return pathlib.Path(str(raw))
    return pathlib.Path("prompt-log")


def _table(title: str, columns: list[str], rows: list[list], *, csv_out: bool) -> None:
    """One report, as aligned text with a title, or as CSV with the title as a comment."""
    cells = [
        [
            ("" if v is None else f"{v:,}" if isinstance(v, int) else f"{v:g}" if isinstance(v, float) else str(v))
            for v in row
        ]
        for row in rows
    ]
    if csv_out:
        out = csv.writer(sys.stdout)
        sys.stdout.write(f"# {title}\n")
        out.writerow(columns)
        out.writerows(cells)
        sys.stdout.write("\n")
        return
    widths = [max(len(c), *(len(r[i]) for r in cells)) if cells else len(c) for i, c in enumerate(columns)]
    numeric = [all(isinstance(r[i], (int, float)) or r[i] is None for r in rows) for i in range(len(columns))]

    def line(values):
        return "  ".join(v.rjust(w) if n else v.ljust(w) for v, w, n in zip(values, widths, numeric, strict=True))

    print(title)
    print(line(columns))
    print(line(["-" * w for w in widths]))
    for row in cells:
        print(line(row))
    print()


def _report(log_dir: pathlib.Path, days: list[dt.date], *, csv_out: bool) -> None:
    rep = prompt_log.report(prompt_log.read_days(log_dir, days))
    span = f"{days[0]} to {days[-1]}" if len(days) > 1 else str(days[0])
    if not csv_out:
        print(f"{fmt.plural(rep.records, 'request')} over {span}, {fmt.plural(len(rep.days), 'day')} with records\n")
    n = max(1, len(days))
    for title, rows in (
        ("By project", rep.by_project),
        ("By user", rep.by_user),
        ("By model", rep.by_model),
        ("By tool", rep.by_agent),
    ):
        _table(
            title,
            ["name", "requests", "per day", "prompt tokens"],
            [[r.name, r.requests, round(r.requests / n, 1), r.prompt_tokens] for r in rows],
            csv_out=csv_out,
        )
    buckets = [b for _l, b in prompt_log.PROMPT_BUCKETS]
    _table(
        "Prompt length, successful requests",
        ["model", *buckets],
        [[r.model, *(r[b] for b in buckets)] for r in rep.prompt_len],
        csv_out=csv_out,
    )
    _table(
        "Shares, all requests",
        ["model", "requests", "streamed", "with tools", "cut off at max_tokens"],
        [[r.model, r.requests, r.streamed, r.with_tools, r.finish_length] for r in rep.shares],
        csv_out=csv_out,
    )
    _table(
        "Failures by class",
        ["model", "error", "count"],
        [[r.model, r.error, r.count] for r in rep.failures],
        csv_out=csv_out,
    )
    _table(
        "Messages per request",
        ["model", "median", "95th percentile"],
        [[r.model, r.p50, r.p95] for r in rep.conversation],
        csv_out=csv_out,
    )


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="command", required=True)
    roll = sub.add_parser("rollup", help="one day, per model per hour, as the demand rollup reads it")
    roll.add_argument("day", type=dt.date.fromisoformat, help="a UTC day, YYYY-MM-DD")
    roll.add_argument("--json", action="store_true", required=True, help="print one JSON document")
    rep = sub.add_parser("report", help="the reports over a span of days, as text or CSV")
    rep.add_argument("--days", type=int, default=7, help="the last N closed UTC days (default %(default)s)")
    rep.add_argument("--from", dest="start", type=dt.date.fromisoformat, help="first day, instead of --days")
    rep.add_argument("--to", dest="end", type=dt.date.fromisoformat, help="last day (default: yesterday)")
    rep.add_argument("--csv", action="store_true", help="CSV, one block per report, instead of text")
    # Accepted before or after the subcommand; the runner puts it after. The
    # subcommands' copies suppress their default so they cannot clobber a
    # value given before them.
    ap.add_argument("--log-dir", type=pathlib.Path, default=None, help="the prompt log directory")
    for parser in (roll, rep):
        parser.add_argument("--log-dir", type=pathlib.Path, default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    args = ap.parse_args(argv)
    log_dir = args.log_dir or _default_log_dir()
    if args.command == "rollup":
        json.dump(prompt_log.rollup_json(log_dir, args.day), sys.stdout)
        sys.stdout.write("\n")
    else:
        end = args.end or dt.datetime.now(dt.UTC).date() - dt.timedelta(days=1)
        start = args.start or end - dt.timedelta(days=args.days - 1)
        if start > end:
            ap.error("--from is after --to")
        days = [start + dt.timedelta(days=i) for i in range((end - start).days + 1)]
        _report(log_dir, days, csv_out=args.csv)
    return 0


if __name__ == "__main__":
    sys.exit(main())
