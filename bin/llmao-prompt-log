"""One day of the prompt log, rolled up for the portal.

    sudo ./bin/llmao-prompt-log rollup --json 2026-11-01 --log-dir /x1/llmao/prompt-log

Reads that day's file, plain or compressed, and prints one JSON document:
the log-only fields per model per hour, and the day's request count per
model for the reconciliation (docs/prompt-logging-design.md, "The
post-process"). The portal's demand-rollup runner spawns this for each
day it rolls up, so the directory is always given: the tool never reads
config.yaml, never opens a connection to LiteLLM, and never writes in the
log directory.

The reports for a person are in analysis/prompt-report.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import pathlib
import sys

from llmao import prompt_log


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="command", required=True)
    roll = sub.add_parser("rollup", help="one day, per model per hour, as the demand rollup reads it")
    roll.add_argument("day", type=dt.date.fromisoformat, help="a UTC day, YYYY-MM-DD")
    roll.add_argument("--json", action="store_true", required=True, help="print one JSON document")
    # Accepted before or after the subcommand; the runner puts it after.
    ap.add_argument("--log-dir", type=pathlib.Path, default=None, help="the prompt log directory")
    roll.add_argument("--log-dir", type=pathlib.Path, default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    args = ap.parse_args(argv)
    if not args.log_dir:
        ap.error("--log-dir is required")
    json.dump(prompt_log.rollup_json(args.log_dir, args.day), sys.stdout)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
