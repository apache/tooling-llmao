#!/usr/bin/env python3
"""Find where a model starts queueing, by filling its KV cache.

    export VLLM_API_KEY=...
    llmao-saturate --model qwen3.8-27b
    llmao-saturate --all --prompt-tokens 32000
    llmao-saturate --model qwen3-8b --levels 8,16,32,64

Hits the boxes directly. LiteLLM in the path adds its own limits and
confuses the question.

WHY LARGE PROMPTS

KV cache is consumed by CONTEXT, not by request count. Eight 60-token
prompts occupy 480 tokens of a 1.7M-token cache -- 0.03%. A load test built
from small prompts can never queue anything, and "Waiting: 0" from such a
test proves nothing. We learned this the slow way.

    prompt size    concurrent requests to fill 1.7M tokens
    4,000          429
    32,000         54
    100,000        17

The filler is randomised rather than a repeated phrase: prefix caching hits
47-60% here, and identical prompts would be deduplicated so the cache would
never fill.

Output is capped at 100 tokens on purpose. This measures context pressure,
not generation speed.

HOW TO READ IT

  A transient wait of 1-2       normal. Prefills are serialised, so with
                                large prompts something is almost always
                                momentarily queued. Not a finding.

  Sustained queue, KV% low      the SCHEDULER is the limit.
                                Raise --max-num-batched-tokens. The default
                                2048 held every box here to 2-3 concurrent
                                while 90% of memory sat idle; 16384 took the
                                27B from 2 to 38.

  Sustained queue, KV% >= 70    MEMORY is the limit. Raise
                                gpu-memory-utilization, enable
                                --kv-cache-dtype fp8, or lower
                                --max-model-len. Only here does a bigger
                                card help.

  No sustained queue at all     headroom, or the test is too weak. Larger prompts or
                                higher concurrency -- not a conclusion about
                                the hardware.

  p95 >> p50                    queueing: a tail is waiting.
  both rising together          genuine saturation.

Reads scheduler state from the box's /metrics endpoint, which reports live
values. An earlier version parsed the container log and got stale numbers --
a level that finished in 2s reported the PREVIOUS level's peak, which is how
a 4k run and a 32k run both came back at exactly 7.0%.
"""
from __future__ import annotations

import argparse
import json
import os
import random
import statistics
import sys
import time
import urllib.error
import urllib.request
from concurrent.futures import ThreadPoolExecutor

# No endpoints committed here -- discovered from LiteLLM's routing table on
# the gateway host, or LLMAO_DIRECT_<MODEL> elsewhere. See _discover.py.
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _discover import direct_endpoints          # noqa: E402

# The window comes from the box itself at runtime, not from a table here:
# it changes whenever a box is relaunched with a different --max-model-len,
# and a stale value would silently send prompts that cannot fit.
def context_window(hostport: str, key: str) -> int:
    req = urllib.request.Request(
        f"http://{hostport}/v1/models",
        headers={"Authorization": f"Bearer {key}"})
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            return int(json.load(r)["data"][0].get("max_model_len") or 0)
    except Exception:
        return 0

WORDS = ("alpha bravo charlie delta echo foxtrot golf hotel india juliet kilo "
         "lima mike november oscar papa quebec romeo sierra tango uniform "
         "victor whiskey xray yankee zulu").split()


def make_prompt(tokens: int, seed: int) -> str:
    rng = random.Random(seed)
    body = " ".join(rng.choice(WORDS) for _ in range(int(tokens / 1.3)))
    return (f"Here is a word list.\n\n{body}\n\nHow many words is that, to "
            f"the nearest thousand? Answer with a number only.")


def scheduler_state(hostport: str, key: str) -> tuple[int, int, float]:
    """(running, waiting, kv %) live from /metrics, or (-1,-1,-1)."""
    req = urllib.request.Request(
        f"http://{hostport}/metrics",
        headers={"Authorization": f"Bearer {key}"})
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            text = r.read().decode()
    except Exception:
        return (-1, -1, -1.0)
    run = wait = -1
    kv = -1.0
    for ln in text.splitlines():
        if ln.startswith("#"):
            continue
        try:
            if ln.startswith("vllm:num_requests_running"):
                run = int(float(ln.rsplit(" ", 1)[1]))
            elif ln.startswith("vllm:num_requests_waiting{"):
                wait = int(float(ln.rsplit(" ", 1)[1]))
            elif ln.startswith("vllm:kv_cache_usage_perc"):
                kv = float(ln.rsplit(" ", 1)[1]) * 100
        except (IndexError, ValueError):
            continue
    return run, wait, kv


def call(hostport: str, key: str, model: str, prompt: str,
         max_tokens: int, timeout: int) -> dict:
    body = json.dumps({
        "model": model,
        "messages": [{"role": "user", "content": prompt}],
        "chat_template_kwargs": {"enable_thinking": False},
        "max_tokens": max_tokens}).encode()
    req = urllib.request.Request(
        f"http://{hostport}/v1/chat/completions", data=body,
        headers={"Authorization": f"Bearer {key}",
                 "Content-Type": "application/json"})
    t0 = time.monotonic()
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            json.loads(r.read().decode())
        return {"ok": True, "wall": time.monotonic() - t0}
    except urllib.error.HTTPError as e:
        return {"ok": False, "wall": time.monotonic() - t0,
                "why": f"HTTP {e.code}", "detail": e.read().decode()[:90]}
    except Exception as e:
        return {"ok": False, "wall": time.monotonic() - t0,
                "why": type(e).__name__, "detail": str(e)[:90]}


def ramp(model: str, hostport: str, key: str, prompt_tokens: int,
         levels: list[int], max_tokens: int, timeout: int) -> None:
    ctx = context_window(hostport, key)
    print(f"\n{'=' * 70}")
    print(f"{model} @ {hostport}   {prompt_tokens:,}-token prompts"
          f"   window {ctx:,}" if ctx else f"{model} @ {hostport}")
    # vLLM rejects a request whose prompt plus max_tokens exceeds the window.
    if ctx and prompt_tokens + max_tokens > ctx:
        print(f"  ! prompt + max_tokens ({prompt_tokens + max_tokens:,}) "
              f"exceeds the window; vLLM will 400")
    print(f"{'conc':>5}{'ok':>5}{'fail':>6}{'p50':>9}{'p95':>9}"
          f"{'run':>6}{'wait':>6}{'KV%':>7}")
    print("-" * 70)

    for conc in levels:
        prompts = [make_prompt(prompt_tokens, i) for i in range(conc)]
        peak_run = peak_wait = 0
        peak_kv = 0.0

        def sample():
            # Poll during the level: a peak between samples is invisible, so
            # sample often rather than once at the end.
            nonlocal peak_run, peak_wait, peak_kv
            r, w, k = scheduler_state(hostport, key)
            peak_run, peak_wait = max(peak_run, r), max(peak_wait, w)
            peak_kv = max(peak_kv, k)

        with ThreadPoolExecutor(max_workers=conc + 1) as pool:
            futs = [pool.submit(call, hostport, key, model, p, max_tokens, timeout)
                    for p in prompts]
            while not all(f.done() for f in futs):
                sample()
                time.sleep(1.0)
            sample()
            rs = [f.result() for f in futs]

        ok = [r for r in rs if r["ok"]]
        walls = sorted(r["wall"] for r in ok)
        p50 = statistics.median(walls) if walls else 0.0
        p95 = walls[min(len(walls) - 1, int(len(walls) * 0.95))] if walls else 0.0
        print(f"{conc:>5}{len(ok):>5}{len(rs) - len(ok):>6}"
              f"{p50:>8.1f}s{p95:>8.1f}s{peak_run:>6}{peak_wait:>6}"
              f"{peak_kv:>6.1f}%")

        if not ok:
            print("  all failed -- stopping")
            for why in {r["why"] for r in rs}:
                print(f"    {why}: {next(r['detail'] for r in rs if r['why'] == why)}")
            return

        # A request or two waiting while another prefills is normal: prefills
        # are serialised, so with large prompts something is almost always
        # momentarily queued. That is not a bottleneck.
        #
        # What matters is a queue that is deep relative to what is running --
        # requests piling up faster than they are admitted. Before the
        # scheduler fix we saw 2 running against 21 waiting; after it, 38
        # running against 10.
        if peak_wait >= max(4, peak_run) and peak_wait > 2:
            if peak_kv >= 70:
                verdict = ("MEMORY -- the KV cache is full. Raise "
                           "gpu-memory-utilization, enable --kv-cache-dtype "
                           "fp8, or lower --max-model-len. A bigger card "
                           "would help here.")
            else:
                verdict = ("SCHEDULER -- queued while memory sits idle. "
                           "Raise --max-num-batched-tokens (default 2048). "
                           "A bigger card would NOT help.")
            print(f"\n  >> sustained queue at {conc} concurrent: "
                  f"{peak_run} running, {peak_wait} waiting, KV {peak_kv:.1f}%")
            print(f"     {verdict}")
            return

    print(f"\n  no sustained queue through {levels[-1]} concurrent.")
    print("  Either there is headroom, or the test is too weak -- try "
          "--prompt-tokens 64000\n  or higher levels. A transient "
          "'wait' of 1-2 is normal prefill serialisation.")


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--model")
    ap.add_argument("--all", action="store_true")
    ap.add_argument("--prompt-tokens", type=int, default=32000)
    ap.add_argument("--max-tokens", type=int, default=100)
    ap.add_argument("--levels", default="2,4,8,16,24,32,48")
    ap.add_argument("--timeout", type=int, default=900)
    args = ap.parse_args()

    key = os.environ.get("VLLM_API_KEY")
    if not key:
        sys.exit("export VLLM_API_KEY first")

    endpoints = direct_endpoints()
    if not endpoints:
        sys.exit("no endpoints discovered.\n"
                 "  on the gateway host: run as root, or export MK=<master key>\n"
                 "  elsewhere: export LLMAO_DIRECT_QWEN3_8B=host:port")

    if args.all:
        models = sorted(endpoints)
    elif args.model:
        models = [args.model]
    else:
        models = [sorted(endpoints)[0]]

    levels = [int(x) for x in args.levels.split(",")]
    print(f"{args.prompt_tokens:,}-token prompts, {args.max_tokens} output, "
          f"ramping until Waiting > 0")
    for m in models:
        hp = endpoints.get(m)
        if not hp:
            print(f"\n{m}: no endpoint discovered "
                  f"(known: {', '.join(sorted(endpoints))})")
            continue
        ramp(m, hp, key, args.prompt_tokens, levels, args.max_tokens,
             args.timeout)


if __name__ == "__main__":
    main()
